# Copy to .env and fill in. Never commit .env.
# Canonical site origin (used for canonical URLs and sitemap)
PUBLIC_SITE_URL=https://www.zanamtech.com

# Hosted form endpoint (Web3Forms-compatible JSON API)
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
# Public, domain-restricted access key issued by the form provider
PUBLIC_FORM_ACCESS_KEY=

# Cookieless analytics (optional; script loads only when both are set)
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
