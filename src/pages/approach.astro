---
import { CircleCheck } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Process from '../components/sections/Process.astro';
import AgencyPartners from '../components/sections/AgencyPartners.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import { accessModel, aiToolPolicy, cadence, engagementModelCatalog } from '../data/engagement';
---

<!-- How We Work (spec 002 FR-023). The address stays /approach; the process a client receives, never team structure. -->
<BaseLayout
  title="How We Work"
  description="How ZanamTech works: technical assessment, written proposal and Statement of Work, staged implementation and continuous managed operations, with five engagement models."
>
  <PageHero
    eyebrow="How We Work"
    title="Consultative engagement, engineered for accountability"
    lead="We do not publish fixed packages or commodity rates. Every partnership starts with an architectural assessment that establishes scope, service levels and deliverables in a written Statement of Work."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'How We Work' }]}
  />

  <div class="container-page section-t">
    <div class="max-w-2xl">
      <p class="eyebrow">Four phases</p>
      <h2 class="mt-3 text-3xl font-bold text-fg">From discovery to continuous operations</h2>
    </div>
  </div>
  <Process detailed withIntro={false} />

  <section
    id="engagement-models"
    aria-labelledby="models-title"
    class="scroll-mt-28 border-y border-border bg-surface/60"
  >
    <div class="container-page section-y">
      <div class="max-w-2xl">
        <p class="eyebrow">Engagement models</p>
        <h2 id="models-title" class="mt-3 text-3xl font-bold text-fg">
          Structured to match your objectives
        </h2>
        <p class="mt-4 text-lg text-muted">
          Commercial terms are defined transparently in each written proposal, under the model that fits your goals.
        </p>
      </div>
      <div class="cards-centred mt-12" data-reveal-group>
        {engagementModelCatalog.map((model) => (
          <GlassCard as="article" data-model={model.id} class="card-hover">
            <h3 class="text-xl font-semibold text-fg">{model.name}</h3>
            <p class="mt-3 text-muted">{model.description}</p>
            <p class="mt-6 text-sm font-semibold text-fg">Best for</p>
            <p class="mt-2 text-sm text-fg">{model.fits}</p>
          </GlassCard>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="cadence-title" class="container-page section-y">
    <div class="max-w-2xl">
      <p class="eyebrow">Every engagement</p>
      <h2 id="cadence-title" class="mt-3 text-3xl font-bold text-fg">
        What you can expect from us
      </h2>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3" data-reveal-group>
      {[
        { title: 'Cadence and reporting', items: cadence },
        { title: 'Access model', items: accessModel },
        { title: 'AI-tool policy', items: aiToolPolicy },
      ].map((group) => (
        <GlassCard class="card-hover">
          <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
          <ul class="mt-5 space-y-3">
            {group.items.map((item) => (
              <li class="flex gap-3 text-sm text-fg">
                <CircleCheck aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-brand-cyan" />
                {item}
              </li>
            ))}
          </ul>
        </GlassCard>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      More detail on security practices, contracts and data residency is on the{' '}
      <a href="/trust" class="font-semibold text-link underline underline-offset-2">
        Security &amp; Trust
      </a>{' '}
      page.
    </p>
  </section>

  <AgencyPartners />

  <CtaBand />
</BaseLayout>
