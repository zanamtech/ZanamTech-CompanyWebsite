---
import IconTile from '../../components/ui/IconTile.astro';
import CheckList from '../../components/ui/CheckList.astro';
import Chip from '../../components/ui/Chip.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { render } from 'astro:content';
import { ArrowRight, Info } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import Faq from '../../components/sections/Faq.astro';
import TierTable from '../../components/content/TierTable.astro';
import SeverityMatrix from '../../components/content/SeverityMatrix.astro';
import { getPublishedServices, servicePillars, type Service } from '../../lib/services';
import { cta } from '../../data/site';
import { resultsFootnote } from '../../data/results';
import { offers } from '../../data/offers';
import { cadence, engagementModelCatalog } from '../../data/engagement';

export async function getStaticPaths() {
  const services = await getPublishedServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, all: services },
  }));
}

interface Props {
  service: Service;
  all: Service[];
}

const { service, all } = Astro.props;
const {
  name,
  icon,
  summary,
  capabilities,
  stack,
  outcome,
  scenarios,
  deliverables,
  engagementTypes,
  faq,
  flagship,
  pillar,
} = service.data;
const hasReal = scenarios.some((s) => s.kind === 'real');
const { Content } = await render(service);
// Always three related services: same pillar first, then cross-pillar picks in catalogue order.
const related = [
  ...all.filter((s) => s.data.pillar === pillar && s.id !== service.id),
  ...all.filter((s) => s.data.pillar !== pillar),
].slice(0, 3);
const relatedOffer = offers.find((o) => o.id === service.data.relatedOffer);
const engagementModels = engagementModelCatalog.filter((m) => engagementTypes.includes(m.id));
const contactHref = `${cta.href}?service=${service.id}`;
---

<BaseLayout title={service.data.seoTitle ?? name} description={summary}>
  <PageHero
    eyebrow={servicePillars[pillar].title}
    title={name}
    lead={summary}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: name }]}
  >
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
      <Button href={contactHref} size="lg">
        {cta.primary}
        <ArrowRight aria-hidden="true" class="size-4.5" />
      </Button>
    </div>
  </PageHero>

  <div class="container-page section-y grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <section aria-labelledby="overview-title">
        <div class="flex items-center gap-4">
          <IconTile>
            <Icon name={icon} class="size-6" />
          </IconTile>
          <h2 id="overview-title" class="text-2xl font-bold text-fg">
            Overview
          </h2>
        </div>
        <div class="prose-content mt-6 space-y-4 text-lg text-muted">
          <Content />
        </div>
      </section>

      <section aria-labelledby="capabilities-title" class="mt-14">
        <h2 id="capabilities-title" class="text-2xl font-bold text-fg">
          {flagship ? 'What the service covers' : 'Core capabilities'}
        </h2>
        <CheckList items={capabilities} class="mt-6 space-y-4" itemClass="flex gap-3" icon="md" wrap="text-fg" />
      </section>

      <section aria-labelledby="deliverables-title" class="mt-14">
        <h2 id="deliverables-title" class="text-2xl font-bold text-fg">
          What you get
        </h2>
        <CheckList
          items={deliverables}
          class="mt-6 grid gap-4 sm:grid-cols-2"
          itemClass="flex gap-3"
          icon="md"
          wrap="text-fg"
        />
      </section>
    </div>

    <aside class="space-y-6 lg:col-span-5" aria-label="Service summary">
      <GlassCard class="relative">
        <div class="hairline-gradient absolute inset-x-6 top-0" aria-hidden="true"></div>
        <p class="text-sm font-semibold text-accent">Outcome</p>
        <p class="mt-2 text-xl font-semibold text-fg">{outcome}</p>
        {hasReal && (
          <p class="mt-4 flex gap-2 text-sm text-muted">
            <Info aria-hidden="true" class="mt-0.5 size-4 shrink-0" />
            {resultsFootnote}
          </p>
        )}
      </GlassCard>

      <GlassCard>
        <h2 class="text-sm font-semibold text-fg">How you can engage</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {engagementModels.map((model) => (
            <li>
              <a
                href="/approach#engagement-models"
                data-engagement-chip={model.id}
                class="inline-flex min-h-9 items-center rounded-full border border-border-strong px-3.5 text-sm font-medium text-fg transition-colors duration-200 hover:border-accent hover:text-accent"
              >
                {model.name}
              </a>
            </li>
          ))}
        </ul>
      </GlassCard>

      <GlassCard>
        <h2 class="text-sm font-semibold text-fg">Technology stack</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {stack.map((tech) => (
            <Chip label={tech} />
          ))}
        </ul>
      </GlassCard>

      {relatedOffer && (
        <GlassCard class="card-hover">
          <p class="text-sm font-semibold text-accent">A low-risk way to start</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <h2 class="text-lg font-semibold text-fg">{relatedOffer.name}</h2>
            <Badge tone="accent">{relatedOffer.duration}</Badge>
          </div>
          <p class="mt-2 text-sm text-muted">{relatedOffer.summary}</p>
          <ArrowLink href={`/start-here#${relatedOffer.id}`} class="mt-4 text-sm" label="See entry offers" />
        </GlassCard>
      )}
    </aside>
  </div>

  {flagship && (
    <>
      <section aria-labelledby="tiers-title" class="container-page section-y pt-0!">
        <SectionHeader
          eyebrow="Retainer tiers"
          title="Choose the coverage your platform needs"
          titleId="tiers-title"
          size="md"
        />
        <div class="mt-10">
          <TierTable />
        </div>
      </section>

      <section aria-labelledby="severity-title" class="container-page section-b">
        <SectionHeader
          eyebrow="Severity definitions"
          title="How incidents are classified"
          titleId="severity-title"
          lead="Response targets for each severity are agreed in your Statement of Work."
          leadSize="base"
          size="md"
        />
        <div class="mt-10">
          <SeverityMatrix />
        </div>
      </section>

      <section aria-labelledby="operating-title" class="container-page section-b">
        <div class="grid gap-6 lg:grid-cols-3">
          <GlassCard>
            <h2 id="operating-title" class="text-lg font-semibold text-fg">
              Reporting cadence
            </h2>
            <CheckList items={cadence} class="mt-4 space-y-2" itemClass="flex gap-2 text-sm text-fg" />
          </GlassCard>
          <GlassCard>
            <h2 class="text-lg font-semibold text-fg">4-week onboarding</h2>
            <p class="mt-4 text-sm text-muted">
              Least-privilege access set up, a platform review, runbook and diagram baselines, monitoring and backup
              checks, and an agreed reporting format before steady-state operations begin.
            </p>
          </GlassCard>
          <GlassCard>
            <h2 class="text-lg font-semibold text-fg">Exit terms</h2>
            <p class="mt-4 text-sm text-muted">
              A three-month minimum, then rolling with one month's notice. Runbooks, diagrams, code and credentials stay
              in your accounts, and you receive a documented handover. No lock-in.
            </p>
          </GlassCard>
        </div>
      </section>
    </>
  )}

  <section aria-labelledby="scenarios-title" class="border-y border-border bg-surface/60">
    <div class="container-page section-y">
      <SectionHeader
        eyebrow="In practice"
        title="Engagements in practice"
        titleId="scenarios-title"
        lead={
          hasReal
            ? 'Anonymised results from past engagements. Entries marked "Example engagement" are illustrative and carry no figures.'
            : 'Example engagements that illustrate how this service is typically delivered. They are illustrative and carry no figures.'
        }
        leadSize="base"
        size="md"
      />

      <ol class="mt-10 grid gap-6 lg:grid-cols-2">
        {scenarios.map((scenario) => (
          <li data-scenario class="glass card-hover flex flex-col rounded-2xl p-6 sm:p-7">
            {scenario.kind === 'illustrative' && (
              <p class="mb-5 text-sm font-semibold text-accent">Example engagement</p>
            )}
            <dl class="space-y-5">
              <div>
                <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Challenge</dt>
                <dd class="mt-1 text-fg">{scenario.problem}</dd>
              </div>
              <div>
                <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Approach</dt>
                <dd class="mt-1 text-fg">{scenario.solution}</dd>
              </div>
              <div class="rounded-xl border border-border bg-surface-2/70 p-4">
                <dt class="text-sm font-semibold tracking-wide text-accent uppercase">Outcome</dt>
                <dd class="mt-1 font-medium text-fg">{scenario.outcome}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ol>
      {hasReal && <p class="mt-6 text-sm text-muted">{resultsFootnote}</p>}
    </div>
  </section>

  {faq && faq.length > 0 && <Faq items={faq} id="service-faq" title={`${name}: common questions`} />}

  {related.length > 0 && (
    <section aria-labelledby="related-title" class="container-page section-y">
      <h2 id="related-title" class="text-2xl font-bold text-fg">
        Related services
      </h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => (
          <ServiceCard service={s} numbered={false} />
        ))}
      </ul>
    </section>
  )}

  <CtaBand
    href={contactHref}
    title={`Discuss ${name}`}
    body="Begin with a technical audit of your current environment. Scope, deliverables, milestones and service levels are defined in a written proposal and Statement of Work."
  />
</BaseLayout>
