---
import { render } from 'astro:content';
import { ArrowRight, CircleCheck, Info } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceCard from '../../components/sections/ServiceCard.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { getActiveServices, serviceGroups, type Service } from '../../lib/services';
import { cta, metricsFootnote } from '../../data/site';

export async function getStaticPaths() {
  const services = await getActiveServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, all: services },
  }));
}

interface Props {
  service: Service;
  all: Service[];
}

const { service, all } = Astro.props;
const { name, icon, summary, capabilities, stack, outcome, scenarios, group } = service.data;
const { Content } = await render(service);
const related = all.filter((s) => s.data.group === group && s.id !== service.id).slice(0, 3);
const contactHref = `${cta.href}?service=${service.id}`;
---

<BaseLayout title={name} description={summary}>
  <PageHero
    eyebrow={serviceGroups[group].title}
    title={name}
    lead={summary}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: name }]}
  >
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
      <Button href={contactHref} size="lg" contactCta data-service={service.id}>
        {cta.primary}
        <ArrowRight aria-hidden="true" className="size-4.5" />
      </Button>
    </div>
  </PageHero>

  <div class="container-page grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-20">
    <div class="lg:col-span-7">
      <section aria-labelledby="overview-title">
        <div class="flex items-center gap-4">
          <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
            <Icon name={icon} class="size-6" />
          </span>
          <h2 id="overview-title" class="text-2xl font-bold text-fg">Overview</h2>
        </div>
        <div class="prose-content mt-6 space-y-4 text-lg text-muted">
          <Content />
        </div>
      </section>

      <section aria-labelledby="capabilities-title" class="mt-14">
        <h2 id="capabilities-title" class="text-2xl font-bold text-fg">Core capabilities</h2>
        <ul class="mt-6 space-y-4">
          {
            capabilities.map((item) => (
              <li class="flex gap-3">
                <CircleCheck aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-brand-cyan" />
                <span class="text-fg">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <aside class="space-y-6 lg:col-span-5" aria-label="Service summary">
      <GlassCard class="relative">
        <div class="hairline-gradient absolute inset-x-6 top-0" aria-hidden="true"></div>
        <p class="text-sm font-semibold text-accent">Target outcome</p>
        <p class="mt-2 text-xl font-semibold text-fg">{outcome}</p>
        <p class="mt-4 flex gap-2 text-sm text-muted">
          <Info aria-hidden="true" className="mt-0.5 size-4 shrink-0" />
          {metricsFootnote}
        </p>
      </GlassCard>

      <GlassCard>
        <h2 class="text-sm font-semibold text-fg">Technology stack</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            stack.map((tech) => (
              <li class="rounded-full border border-border-strong bg-surface/70 px-3 py-1 text-sm font-medium text-fg">
                {tech}
              </li>
            ))
          }
        </ul>
      </GlassCard>
    </aside>
  </div>

  <section aria-labelledby="scenarios-title" class="border-y border-border bg-surface/60">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">In practice</p>
        <h2 id="scenarios-title" class="mt-3 text-3xl font-bold text-fg">Representative Engagement Scenarios</h2>
        <p class="mt-4 text-muted">
          These scenarios illustrate typical engagements and outcomes for this service. They do not describe specific
          named clients.
        </p>
      </div>

      <ol class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          scenarios.map((scenario, i) => (
            <li data-scenario class="glass flex flex-col rounded-2xl p-6 sm:p-7">
              <p class="text-sm font-semibold text-accent">Representative Engagement Scenario {i + 1}</p>
              <dl class="mt-5 space-y-5">
                <div>
                  <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Challenge</dt>
                  <dd class="mt-1 text-fg">{scenario.problem}</dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold tracking-wide text-muted uppercase">Approach</dt>
                  <dd class="mt-1 text-fg">{scenario.solution}</dd>
                </div>
                <div class="rounded-xl border border-border bg-surface-2/70 p-4">
                  <dt class="text-sm font-semibold tracking-wide text-accent uppercase">Outcome</dt>
                  <dd class="mt-1 font-medium text-fg">{scenario.outcome}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm text-muted">{metricsFootnote}</p>
    </div>
  </section>

  {
    related.length > 0 && (
      <section aria-labelledby="related-title" class="container-page py-16 lg:py-20">
        <h2 id="related-title" class="text-2xl font-bold text-fg">Related services</h2>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((s) => (
            <ServiceCard service={s} />
          ))}
        </ul>
      </section>
    )
  }

  <CtaBand
    title={`Discuss ${name}`}
    body="Begin with a technical audit of your current environment. We will define scope, milestones and SLA commitments in a custom proposal and Statement of Work."
  />
</BaseLayout>
