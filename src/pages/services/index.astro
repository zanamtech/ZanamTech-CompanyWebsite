---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceCard from '../../components/sections/ServiceCard.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { displayGroup, getActiveServices, serviceGroups, type ServiceGroup } from '../../lib/services';

const services = await getActiveServices();
const groups = (Object.keys(serviceGroups) as ServiceGroup[]).map((key) => ({
  key,
  ...serviceGroups[key],
  services: services.filter((s) => displayGroup(s) === key),
}));
---

<BaseLayout
  title="Services"
  description="Managed Cloud & DevOps, cloud and DevOps engineering, web and SaaS development, and practical AI automation on Azure and AWS, each scoped in a Statement of Work."
>
  <PageHero
    eyebrow="Services"
    title="Enterprise engineering services"
    lead="We run, secure and modernise Azure and AWS platforms, build cloud-native web applications and automate manual work with practical AI. Every engagement is scoped in a Statement of Work."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  />

  <div class="container-page section-y space-y-12 sm:space-y-16 lg:space-y-20">
    {
      groups.map((group) => (
        <section aria-labelledby={`group-${group.key}`}>
          <div class="max-w-2xl">
            <h2 id={`group-${group.key}`} class="text-2xl font-bold text-fg sm:text-3xl">
              {group.title}
            </h2>
            <p class="mt-3 text-muted">{group.description}</p>
          </div>
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.services.map((service) => (
              <ServiceCard service={service} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <CtaBand />
</BaseLayout>
