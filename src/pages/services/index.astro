---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
import EntryOffers from '../../components/sections/EntryOffers.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getServicesByPillar } from '../../lib/services';
import { flagshipIncluded } from '../../data/managed-tiers';

const pillars = await getServicesByPillar();
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Services' }];
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  title="Services"
  description="Managed Cloud & DevOps, Cloud & DevOps engineering, web & SaaS development and AI automation on AWS, Azure and Google Cloud, scoped in a Statement of Work."
>
  <PageHero
    eyebrow="Services"
    title="Enterprise engineering services"
    lead="We run, secure and modernise AWS, Azure and Google Cloud platforms, build cloud-native web applications and automate manual work with practical AI. Every engagement is scoped in a Statement of Work."
    breadcrumbs={breadcrumbs}
  />

  <div class="container-page section-y space-y-12 sm:space-y-16 lg:space-y-20">
    {pillars.map((p) => (
      <section id={p.pillar} aria-labelledby={`pillar-${p.pillar}`}>
        <div class="max-w-2xl">
          <h2 id={`pillar-${p.pillar}`} class="text-2xl font-bold text-fg sm:text-3xl">
            {p.title}
          </h2>
          <p class="mt-3 text-muted">{p.description}</p>
        </div>
        {/* No empty slots: one service → a full-width feature card; two → a two-column row; more → three across with
              the last row centred. */}
        <ul
          class:list={[
            'mt-10',
            p.services.length === 1 ? 'grid' : p.services.length === 2 ? 'grid gap-6 sm:grid-cols-2' : 'cards-centred',
          ]}
        >
          {p.services.map((service) =>
            p.services.length === 1 ? (
              <ServiceCard service={service} layout="feature" included={flagshipIncluded} />
            ) : (
              <ServiceCard service={service} />
            ),
          )}
        </ul>
      </section>
    ))}
  </div>

  <EntryOffers compact />

  <CtaBand />
</BaseLayout>
