---
import { CircleCheck, Compass, Target, Users } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import { pillars } from '../data/site';

const capabilities = [
  {
    title: 'Cloud & Infrastructure',
    items: [
      'Multi-cloud migration across AWS, Azure and GCP',
      'Kubernetes and Docker architecture',
      'Active observability and monitoring',
      'Cloud cost optimization audits',
      'High availability and disaster recovery',
    ],
  },
  {
    title: 'Enterprise Engineering & AI',
    items: [
      'Custom full-stack web applications',
      'Private LLM and secure document retrieval (RAG)',
      'DevSecOps CI/CD pipeline automation',
      'Zero-trust security and WAF hardening',
      '24/7 managed infrastructure retainers',
    ],
  },
];

const principles = [
  {
    Icon: Target,
    title: 'Verified outcomes over hype',
    body: 'We commit to measurable targets defined in a Statement of Work and report against them throughout delivery.',
  },
  {
    Icon: Users,
    title: 'Direct senior access',
    body: 'Clients work directly with senior cloud, security and AI architects, with boutique responsiveness and none of the overhead of large consultancies.',
  },
  {
    Icon: Compass,
    title: 'Privacy by design',
    body: 'AI and data workflows are engineered to keep proprietary information inside your perimeter, never exposed to public third-party APIs.',
  },
];
---

<BaseLayout
  title="About"
  description="ZanamTech is an enterprise-grade technology consultancy specializing in cloud architecture, zero-trust security, DevSecOps automation, full-stack applications and private enterprise AI."
>
  <PageHero
    eyebrow="About ZanamTech"
    title="Enterprise-grade engineering, delivered with boutique precision"
    lead="ZanamTech is a technology consultancy specializing in enterprise cloud architecture, zero-trust cyber security, DevSecOps automation, custom full-stack applications and intelligent enterprise AI integration."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  <section aria-labelledby="mission-title" class="container-page grid gap-12 py-20 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow">Mission</p>
      <h2 id="mission-title" class="mt-3 text-3xl font-bold text-fg">Our mission</h2>
      <div class="mt-5 space-y-4 text-lg text-muted">
        <p>
          We bridge the gap between legacy cloud operations and the next generation of privacy-first, intelligent
          automation. Modern enterprises need systems that are resilient and scalable, and also natively intelligent and
          securely architected.
        </p>
        <p>
          We engineer high-performance cloud environments, establish automated release pipelines, enforce zero-trust
          security perimeters and embed data-compliant AI workflows into core business processes.
        </p>
      </div>
    </div>
    <GlassCard class="self-start lg:col-span-5">
      <p class="text-sm font-semibold text-accent">What we stand for</p>
      <ul class="mt-5 space-y-4">
        {
          pillars.map((p) => (
            <li class="flex items-center gap-3 text-lg font-semibold text-fg">
              <CircleCheck aria-hidden="true" className="size-5 shrink-0 text-brand-cyan" />
              {p}
            </li>
          ))
        }
      </ul>
    </GlassCard>
  </section>

  <section aria-labelledby="philosophy-title" class="border-y border-border bg-surface/60">
    <div class="container-page py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Philosophy</p>
        <h2 id="philosophy-title" class="mt-3 text-3xl font-bold text-fg">Pragmatic Enterprise First</h2>
        <p class="mt-4 text-lg text-muted">
          We reject speculative technology hype in favour of verified engineering outcomes, zero-downtime reliability and
          privacy-compliant AI integration.
        </p>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          principles.map(({ Icon, title, body }) => (
            <GlassCard as="li">
              <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
                <Icon aria-hidden="true" className="size-6" />
              </span>
              <h3 class="mt-5 text-lg font-semibold text-fg">{title}</h3>
              <p class="mt-2 text-muted">{body}</p>
            </GlassCard>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="capabilities-title" class="container-page py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Capabilities</p>
      <h2 id="capabilities-title" class="mt-3 text-3xl font-bold text-fg">Core capabilities</h2>
      <p class="mt-4 text-lg text-muted">
        Deep expertise across multi-cloud infrastructure, container orchestration, Linux systems engineering, enterprise
        threat mitigation and private AI.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        capabilities.map((group) => (
          <GlassCard>
            <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
            <ul class="mt-5 space-y-3">
              {group.items.map((item) => (
                <li class="flex gap-3 text-fg">
                  <CircleCheck aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-brand-cyan" />
                  {item}
                </li>
              ))}
            </ul>
          </GlassCard>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="model-title" class="container-page pb-12">
    <GlassCard class="relative p-8 sm:p-10">
      <div class="hairline-gradient absolute inset-x-10 top-0" aria-hidden="true"></div>
      <h2 id="model-title" class="text-2xl font-bold text-fg">A consultative engagement model</h2>
      <p class="mt-4 max-w-3xl text-muted">
        Rather than rigid public packages, every partnership begins with a comprehensive technical audit and strategic
        alignment. Clients receive high-touch engineering responsiveness with SLA commitments defined in each Statement
        of Work.
      </p>
      <a href="/approach" class="mt-6 inline-flex min-h-11 items-center font-semibold text-link hover:underline">
        See how we engage
      </a>
    </GlassCard>
  </section>

  <CtaBand />
</BaseLayout>
