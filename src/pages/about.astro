---
import { ArrowRight, CircleCheck, Compass, Target, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import LinkedInIcon from '../components/ui/LinkedInIcon.astro';
import { Image } from 'astro:assets';
import { leadership } from '../data/leadership';
import { regionsServed } from '../data/site';
import { engagementModelCatalog } from '../data/engagement';
import founderPhoto from '../assets/team/mubashir.jpg';

// Facts only (Constitution III): no experience-length claims, no response targets.
// Engagement labels come from the /approach catalogue so the two pages always match.
const atAGlance = [
  { label: 'Clouds', values: ['AWS', 'Azure', 'Google Cloud', 'Flexential', 'Liquid Web'] },
  { label: 'Regions served', values: [...regionsServed] },
  { label: 'Engagement', values: engagementModelCatalog.map((m) => m.name) },
  { label: 'Clients', values: ['B2B SaaS companies', 'Software agencies', 'Mid-market firms', 'Enterprise teams'] },
];

const capabilities = [
  {
    title: 'Cloud & Infrastructure',
    items: [
      'Cloud migration and modernisation on AWS, Azure and Google Cloud',
      'Kubernetes and Docker architecture',
      'Active observability and monitoring',
      'High availability and disaster recovery',
    ],
  },
  {
    title: 'Enterprise Engineering & AI',
    items: [
      'Custom full-stack web applications',
      'AI workflow automation and assistants on company data',
      'DevSecOps CI/CD pipeline automation',
      'Managed Cloud & DevOps retainers',
    ],
  },
];

const principles = [
  {
    Icon: Target,
    title: 'Verified outcomes over hype',
    body: 'Every engagement runs on a written Statement of Work with agreed deliverables, reported against throughout delivery.',
  },
  {
    Icon: Users,
    title: 'Documented, accountable delivery',
    body: 'Weekly status, monthly service reviews, documented runbooks and a full handover, with none of the overhead of large consultancies.',
  },
  {
    Icon: Compass,
    title: 'Privacy by design',
    body: 'AI and data workflows are engineered to keep proprietary information inside your perimeter, never exposed to public third-party APIs.',
  },
];
---

<BaseLayout
  title="About"
  description="ZanamTech is a Cloud, DevOps & AI engineering firm: managed cloud operations, cloud and DevOps engineering, web and SaaS development, and practical AI automation."
>
  <PageHero
    eyebrow="About ZanamTech"
    title="Enterprise-grade engineering, delivered with boutique precision"
    lead="ZanamTech is a Cloud, DevOps & AI engineering firm. We run, secure and modernise the cloud platforms growing businesses depend on, and automate the work that slows them down."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  <section
    aria-labelledby="mission-title"
    class="container-page section-b grid gap-12 pt-6 sm:pt-8 lg:grid-cols-12 lg:pt-10"
  >
    <div class="lg:col-span-7">
      <p class="eyebrow">Mission</p>
      <h2 id="mission-title" class="mt-3 text-3xl font-bold text-fg">
        Our mission
      </h2>
      <div class="mt-5 space-y-4 text-lg text-muted">
        <p>
          We bridge the gap between legacy cloud operations and the next generation of privacy-first, intelligent
          automation. Modern enterprises need systems that are resilient and scalable, and also natively intelligent and
          securely architected.
        </p>
        <p>
          We engineer high-performance cloud environments, establish automated release pipelines, enforce zero-trust
          security perimeters and embed data-compliant AI workflows into core business processes.
        </p>
      </div>
    </div>
    <GlassCard class="self-start lg:col-span-5">
      <h2 id="glance-title" class="text-sm font-semibold text-accent">
        At a glance
      </h2>
      <dl class="mt-5 space-y-4" aria-labelledby="glance-title" data-at-a-glance>
        {atAGlance.map((row) => (
          <div>
            <dt class="text-xs font-semibold tracking-wide text-muted uppercase">{row.label}</dt>
            <dd class="mt-2">
              <ul class="flex flex-wrap gap-2">
                {row.values.map((value) => (
                  <li class="cursor-default select-none rounded-full border border-border/60 bg-surface-2/40 px-3.5 py-1.5 text-sm font-medium text-fg/80 backdrop-blur-sm transition-all duration-300 ease-in-out hover:scale-[1.02] hover:border-accent/60 hover:bg-surface-2/70 hover:text-fg hover:shadow-md hover:shadow-purple-500/10 motion-reduce:hover:scale-100">
                    {value}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </GlassCard>
  </section>

  <section aria-labelledby="leadership-title" class="container-page section-b">
    <GlassCard class="relative p-8 sm:p-10">
      <div class="hairline-gradient absolute inset-x-10 top-0" aria-hidden="true"></div>
      <!-- Phones: eyebrow, photo, name, role, LinkedIn, bio (DOM order). From md a 3-column grid: the eyebrow sits on the
           name row with their cap tops level (3px nudge), the LinkedIn button sits top-right on that row, and the photo is centred against the
           role + bio rows, so it stays centred whatever the bio length. -->
      <div
        class="flex flex-col items-start md:grid md:grid-cols-[10rem_minmax(0,1fr)_auto] md:items-start md:gap-x-8 lg:grid-cols-[13rem_minmax(0,1fr)_auto] lg:gap-x-10"
        data-founder-card
      >
        <p class="eyebrow md:col-start-1 md:row-start-1 md:mt-[3px] md:self-start">Leadership</p>
        <Image
          src={founderPhoto}
          alt={`${leadership.name}, ${leadership.role}`}
          width={416}
          height={416}
          fit="cover"
          position="top"
          class="mt-5 aspect-square w-full max-w-40 rounded-2xl object-cover object-top md:col-start-1 md:row-span-2 md:row-start-2 md:mt-0 md:max-w-none md:self-center"
          loading="lazy"
          data-founder-photo
        />
        <h2
          id="leadership-title"
          class="mt-6 text-2xl font-bold text-fg md:col-start-2 md:row-start-1 md:mt-0 md:self-start"
        >
          {leadership.name}
        </h2>
        <p class="mt-1 font-semibold text-accent md:col-span-2 md:col-start-2 md:row-start-2">{leadership.role}</p>
        {leadership.linkedin && (
          <a
            href={leadership.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${leadership.name} on LinkedIn`}
            class="mt-3 inline-flex min-h-9 shrink-0 items-center gap-2 rounded-lg border border-border-strong px-3 text-sm font-semibold text-fg transition-colors duration-200 hover:border-accent hover:text-accent md:col-start-3 md:row-start-1 md:mt-0 md:self-center"
            data-founder-linkedin
          >
            <LinkedInIcon class="size-4" />
            LinkedIn
          </a>
        )}
        <div class="mt-4 space-y-3 text-muted md:col-span-2 md:col-start-2 md:row-start-3">
          {leadership.bio.map((line) => (
            <p>{line}</p>
          ))}
          <p>
            As your scope grows, delivery scales with vetted engineers working to the same standards and access
            controls.
          </p>
        </div>
      </div>
    </GlassCard>
  </section>

  <section aria-labelledby="philosophy-title" class="border-y border-border bg-surface/60">
    <div class="container-page section-y">
      <div class="max-w-2xl">
        <p class="eyebrow">Philosophy</p>
        <h2 id="philosophy-title" class="mt-3 text-3xl font-bold text-fg">
          Pragmatic, enterprise-first
        </h2>
        <p class="mt-4 text-lg text-muted">
          We reject speculative technology hype in favour of verified engineering outcomes, resilient operations and
          privacy-conscious AI integration.
        </p>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {principles.map(({ Icon, title, body }) => (
          <GlassCard as="li" class="card-hover">
            <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
              <Icon aria-hidden="true" class="size-6" />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-fg">{title}</h3>
            <p class="mt-2 text-muted">{body}</p>
          </GlassCard>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="capabilities-title" class="container-page section-y">
    <div class="max-w-2xl">
      <p class="eyebrow">Capabilities</p>
      <h2 id="capabilities-title" class="mt-3 text-3xl font-bold text-fg">
        Core capabilities
      </h2>
      <p class="mt-4 text-lg text-muted">
        Deep expertise across multi-cloud infrastructure, container orchestration, Linux systems engineering, enterprise
        threat mitigation and practical AI automation.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
      {capabilities.map((group) => (
        <GlassCard class="card-hover">
          <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
          <ul class="mt-5 space-y-3">
            {group.items.map((item) => (
              <li class="flex gap-3 text-fg">
                <CircleCheck aria-hidden="true" class="mt-0.5 size-5 shrink-0 text-brand-cyan" />
                {item}
              </li>
            ))}
          </ul>
        </GlassCard>
      ))}
    </div>
    <a
      href="/services"
      class="mt-6 inline-flex min-h-11 items-center gap-1.5 font-semibold text-link hover:underline"
      data-view-all-services
    >
      View all services
      <ArrowRight aria-hidden="true" class="size-4" />
    </a>
  </section>

  <section aria-labelledby="model-title" class="container-page pb-12">
    <GlassCard class="relative p-8 sm:p-10">
      <div class="hairline-gradient absolute inset-x-10 top-0" aria-hidden="true"></div>
      <h2 id="model-title" class="text-2xl font-bold text-fg">
        A consultative engagement model
      </h2>
      <p class="mt-4 max-w-3xl text-muted">
        Rather than rigid public packages, every partnership begins with a technical assessment and strategic alignment.
        Coverage, deliverables and service levels are defined in each Statement of Work.
      </p>
      <a href="/approach" class="mt-6 inline-flex min-h-11 items-center font-semibold text-link hover:underline">
        See how we engage
      </a>
    </GlassCard>
  </section>

  <CtaBand />
</BaseLayout>
