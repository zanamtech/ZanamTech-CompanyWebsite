---
import IconTile from '../components/ui/IconTile.astro';
import CheckList from '../components/ui/CheckList.astro';
import { CircleAlert } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import { segments } from '../data/segments';
import { getPublishedServices, serviceHref } from '../lib/services';

const services = await getPublishedServices();
const serviceById = new Map(services.map((s) => [s.id, s]));
---

<BaseLayout
  title="Industries"
  description="ZanamTech serves B2B SaaS companies, mid-market firms on AWS, Azure and Google Cloud, software agencies that need a DevOps partner, and enterprises and scale-ups across the Gulf Cooperation Council (GCC)."
>
  <PageHero
    eyebrow="Industries"
    title="Who we serve"
    lead="Organisations that depend on reliable, secure and cost-efficient cloud platforms, from growing SaaS companies to software agencies and Gulf Cooperation Council (GCC) enterprises."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]}
  />

  <div class="container-page section-y space-y-10" data-reveal-group>
    {segments.map((s) => (
      <article
        data-segment
        aria-labelledby={`segment-${s.id}`}
        class="glass panel-hover grid gap-10 rounded-3xl p-6 sm:p-10 lg:grid-cols-12"
      >
        <div class="lg:col-span-5">
          <IconTile>
            <Icon name={s.icon} class="size-6" />
          </IconTile>
          <h2 id={`segment-${s.id}`} class="mt-5 text-2xl font-bold text-fg">
            {s.name}
          </h2>
          <p class="mt-3 text-muted">{s.profile}</p>
          <p class="mt-6 text-sm font-semibold text-fg">Key stakeholders</p>
          <p class="mt-1 text-sm text-muted">{s.decisionMakers.join(' · ')}</p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:col-span-7">
          <div>
            <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Core challenges</h3>
            <ul class="mt-4 space-y-3">
              {s.challenges.map((c) => (
                <li class="flex gap-2 text-fg">
                  <CircleAlert aria-hidden="true" class="mt-1 size-4 shrink-0 text-muted" />
                  {c}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold tracking-wide text-accent uppercase">How we help</h3>
            <CheckList items={s.value} class="mt-4 space-y-3" itemClass="flex gap-2 text-fg" iconOffset={1} />
          </div>
          <div class="sm:col-span-2">
            <h3 class="text-sm font-semibold text-fg">Relevant services</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {s.services
                .map((id) => serviceById.get(id))
                .filter((svc) => svc !== undefined)
                .map((svc) => (
                  <li>
                    <a
                      href={serviceHref(svc)}
                      class="inline-flex min-h-11 items-center rounded-full border border-border-strong bg-surface/70 px-4 text-sm font-medium text-fg hover:border-accent hover:text-accent"
                    >
                      {svc.data.name}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>

  <CtaBand />
</BaseLayout>
