---
import { CircleAlert, CircleCheck } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import { segments } from '../data/segments';
import { getActiveServices, serviceHref } from '../lib/services';

const services = await getActiveServices();
const serviceById = new Map(services.map((s) => [s.id, s]));
---

<BaseLayout
  title="Industries"
  description="ZanamTech serves high-growth B2B SaaS companies, mid-market enterprises undergoing digital transformation, and data-sensitive organizations adopting private AI."
>
  <PageHero
    eyebrow="Industries"
    title="Who we serve"
    lead="Organizations that demand zero compromise on infrastructure reliability, security and performance, from high-growth SaaS platforms to regulated, data-sensitive enterprises."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]}
  />

  <div class="container-page section-y space-y-10" data-reveal-group>
    {
      segments.map((s) => (
        <article data-segment aria-labelledby={`segment-${s.id}`} class="glass panel-hover grid gap-10 rounded-3xl p-6 sm:p-10 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h2 id={`segment-${s.id}`} class="mt-5 text-2xl font-bold text-fg">
              {s.name}
            </h2>
            <p class="mt-3 text-muted">{s.profile}</p>
            <p class="mt-6 text-sm font-semibold text-fg">Key stakeholders</p>
            <p class="mt-1 text-sm text-muted">{s.decisionMakers.join(' · ')}</p>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:col-span-7">
            <div>
              <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Core challenges</h3>
              <ul class="mt-4 space-y-3">
                {s.challenges.map((c) => (
                  <li class="flex gap-2 text-fg">
                    <CircleAlert aria-hidden="true" className="mt-1 size-4 shrink-0 text-muted" />
                    {c}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold tracking-wide text-accent uppercase">How we help</h3>
              <ul class="mt-4 space-y-3">
                {s.value.map((v) => (
                  <li class="flex gap-2 text-fg">
                    <CircleCheck aria-hidden="true" className="mt-1 size-4 shrink-0 text-brand-cyan" />
                    {v}
                  </li>
                ))}
              </ul>
            </div>
            <div class="sm:col-span-2">
              <h3 class="text-sm font-semibold text-fg">Relevant services</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.services
                  .map((id) => serviceById.get(id))
                  .filter((svc) => svc !== undefined)
                  .map((svc) => (
                    <li>
                      <a
                        href={serviceHref(svc)}
                        class="inline-flex min-h-11 items-center rounded-full border border-border-strong bg-surface/70 px-4 text-sm font-medium text-fg hover:border-accent hover:text-accent"
                      >
                        {svc.data.name}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <CtaBand />
</BaseLayout>
