---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ArticleBody from '../../components/sections/ArticleBody.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Badge from '../../components/ui/Badge.astro';
import Illustration from '../../components/ui/Illustration.astro';
import { isVisible } from '../../lib/content';

type Article = CollectionEntry<'insights'>;

// /insights and /insights/<slug> exist only for visible articles: drafts render in `astro dev` only, so in a build
// this route produces no pages until the owner sets `draft: false` (spec 002 FR-036, SC-010).
export async function getStaticPaths() {
  const articles = (await getCollection('insights', isVisible)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  if (articles.length === 0) return [];
  // The Samples link appears only when at least one sample is visible, so it never points at a missing page.
  const hasSamples = (await getCollection('resources', isVisible)).length > 0;
  return [
    { params: { slug: undefined }, props: { article: undefined, articles, hasSamples } },
    ...articles.map((article) => ({ params: { slug: article.id }, props: { article, articles, hasSamples } })),
  ];
}

interface Props {
  article?: Article;
  articles: Article[];
  hasSamples: boolean;
}

const { article, articles, hasSamples } = Astro.props;
const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const Content = article ? (await render(article)).Content : undefined;
---

{
  article && Content ? (
    <BaseLayout title={article.data.title} description={article.data.summary}>
      <PageHero
        eyebrow="Insights"
        title={article.data.title}
        lead={article.data.summary}
        breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Insights', href: '/insights' }, { label: article.data.title }]}
      >
        <div class="w-full max-w-md shrink-0 overflow-hidden rounded-2xl border border-border lg:w-96 xl:w-md">
          <Illustration topic={article.id} variant="header" />
        </div>
      </PageHero>
      <article class="container-page section-y">
        <div class="mb-6 flex flex-wrap items-center gap-3 text-sm text-muted">
          {article.data.draft && <Badge tone="accent">Draft</Badge>}
          <time datetime={article.data.date.toISOString()}>{dateLabel(article.data.date)}</time>
        </div>
        <ArticleBody>
          <Content />
        </ArticleBody>
        {article.data.sources.length > 0 && (
          <aside aria-labelledby="sources-title" class="mt-12 max-w-3xl border-t border-border pt-6">
            <h2 id="sources-title" class="text-sm font-semibold text-fg">Sources</h2>
            <ul class="mt-3 space-y-2">
              {article.data.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" class="text-sm font-semibold text-link underline underline-offset-2">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
      <CtaBand />
    </BaseLayout>
  ) : (
    <BaseLayout title="Insights" description="Practical writing on cloud operations, DevOps governance, cost control and AI automation.">
      <PageHero
        eyebrow="Insights"
        title="Insights"
        lead="Practical writing on cloud operations, DevOps governance, cost control and AI automation."
        breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Insights' }]}
      />
      <div class="container-page section-y">
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {articles.map((a) => (
            <li data-insight class="glass card-hover group relative flex flex-col rounded-2xl p-6 sm:p-7">
              <div class="mb-5 overflow-hidden rounded-xl border border-border">
                <Illustration topic={a.id} />
              </div>
              <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
                {a.data.draft && <Badge tone="accent">Draft</Badge>}
                <time datetime={a.data.date.toISOString()}>{dateLabel(a.data.date)}</time>
              </div>
              <h2 class="mt-4 text-lg font-semibold text-fg">
                <a href={`/insights/${a.id}`} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">
                  {a.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-muted">{a.data.summary}</p>
              <p class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-link" aria-hidden="true">
                Read the article
                <ArrowRight aria-hidden="true" className="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
              </p>
            </li>
          ))}
        </ul>
        {hasSamples && (
          <p class="mt-10 text-muted">
            Looking for practical examples? See our{' '}
            <a href="/resources" class="font-semibold text-link underline underline-offset-2">
              sample architectures, procedures and reports
            </a>
            .
          </p>
        )}
      </div>
      <CtaBand />
    </BaseLayout>
  )
}

<style>
  li:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
</style>
