---
import ContentCard from '../../components/cards/ContentCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ArticleBody from '../../components/content/ArticleBody.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Badge from '../../components/ui/Badge.astro';
import Illustration from '../../components/ui/Illustration.astro';
import { isPublished, isVisible } from '../../lib/content';
import { leadership } from '../../data/leadership';
import { ogImage } from '../../lib/og';
import { article as articleNode } from '../../lib/schema';

type Article = CollectionEntry<'insights'>;

// /insights and /insights/<slug> exist only for published articles: drafts render in `astro dev` only (spec 002
// FR-036, SC-010), and an article dated after the build date is not built at all (src/lib/publish.ts).
export async function getStaticPaths() {
  const articles = (await getCollection('insights', isPublished)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  if (articles.length === 0) return [];
  // The Samples link appears only when at least one sample is visible, so it never points at a missing page.
  const hasSamples = (await getCollection('resources', isVisible)).length > 0;
  return [
    { params: { slug: undefined }, props: { article: undefined, articles, hasSamples } },
    ...articles.map((article) => ({ params: { slug: article.id }, props: { article, articles, hasSamples } })),
  ];
}

interface Props {
  article?: Article;
  articles: Article[];
  hasSamples: boolean;
}

const { article, articles, hasSamples } = Astro.props;
const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const rendered = article ? await render(article) : undefined;
const Content = rendered?.Content;
// "On this page" table of contents from the article's H2s.
const toc = rendered?.headings.filter((h) => h.depth === 2) ?? [];
// Reading time at ~200 words a minute.
const readMinutes = article
  ? Math.max(1, Math.round((article.body ?? '').split(/\s+/).filter(Boolean).length / 200))
  : 0;
const articleDates = article && { published: article.data.date, modified: article.data.updated ?? article.data.date };
const articleLd =
  article && articleDates
    ? articleNode(
        {
          headline: article.data.title,
          description: article.data.summary,
          ...articleDates,
          path: `/insights/${article.id}`,
          image: ogImage,
        },
        new URL('/', Astro.site),
      )
    : undefined;
const breadcrumbs = article
  ? [{ label: 'Home', href: '/' }, { label: 'Insights', href: '/insights' }, { label: article.data.title }]
  : [{ label: 'Home', href: '/' }, { label: 'Insights' }];
---

{article && Content ? (
  <BaseLayout
    title={article.data.seoTitle ?? article.data.title}
    description={article.data.seoDescription ?? article.data.summary}
    breadcrumbs={breadcrumbs}
    jsonLd={articleLd}
    article={articleDates}
  >
    <PageHero eyebrow="Insights" title={article.data.title} lead={article.data.summary} breadcrumbs={breadcrumbs}>
      <p slot="meta" class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted" data-article-meta>
        {article.data.draft && <Badge tone="accent">Draft</Badge>}
        <span>
          By{' '}
          <a href="/about" class="font-semibold text-fg hover:text-accent">
            {leadership.name}
          </a>
        </span>
        <span aria-hidden="true">·</span>
        <span>{leadership.role}</span>
        <span aria-hidden="true">·</span>
        <time datetime={article.data.date.toISOString()}>{dateLabel(article.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readMinutes} min read</span>
      </p>
      <div class="w-full max-w-md shrink-0 overflow-hidden rounded-2xl border border-border lg:w-96 xl:w-md">
        <Illustration topic={article.id} variant="header" />
      </div>
    </PageHero>
    {/* Desktop: a 720px reading column with a sticky "On this page" list on the right (no empty right half);
          without H2s the column is centred on its own. */}
    <div
      class:list={[
        'container-page section-y',
        toc.length > 0 ? 'lg:grid lg:grid-cols-[minmax(0,45rem)_14rem] lg:justify-center lg:gap-16' : '',
      ]}
    >
      <article class:list={[toc.length === 0 && 'mx-auto max-w-180']}>
        <ArticleBody>
          <Content />
        </ArticleBody>
        {article.data.sources.length > 0 && (
          <aside aria-labelledby="sources-title" class="mt-12 max-w-3xl border-t border-border pt-6">
            <h2 id="sources-title" class="text-sm font-semibold text-fg">
              Sources
            </h2>
            <ul class="mt-3 space-y-2">
              {article.data.sources.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-link underline underline-offset-2"
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
      {toc.length > 0 && (
        <nav aria-labelledby="toc-title" class="hidden lg:block" data-article-toc>
          <div class="sticky top-28">
            <p id="toc-title" class="text-sm font-semibold text-fg">
              On this page
            </p>
            {/* 14px muted text with a clear rail; the section being read is highlighted (src/scripts/article-toc.ts). */}
            <ul class="mt-3 space-y-0.5 border-l-2 border-border-strong">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="-ml-0.5 block border-l-2 border-transparent py-1.5 pl-4 text-sm leading-snug text-muted transition-colors duration-200 hover:text-accent aria-[current=location]:border-accent aria-[current=location]:font-semibold aria-[current=location]:text-accent"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )}
    </div>
    <CtaBand />
  </BaseLayout>
) : (
  <BaseLayout
    breadcrumbs={breadcrumbs}
    title="Insights"
    description="Practical writing on cloud operations, DevOps governance, cost control and AI automation."
  >
    <PageHero
      eyebrow="Insights"
      title="Insights"
      lead="Practical writing on cloud operations, DevOps governance, cost control and AI automation."
      breadcrumbs={breadcrumbs}
    />
    <div class="container-page section-y">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {articles.map((a) => (
          <ContentCard
            data-insight=""
            topic={a.id}
            href={`/insights/${a.id}`}
            title={a.data.title}
            summary={a.data.summary}
            action="Read the article"
            headingLevel={2}
          >
            <div slot="meta" class="flex flex-wrap items-center gap-2 text-sm text-muted">
              {a.data.draft && <Badge tone="accent">Draft</Badge>}
              <time datetime={a.data.date.toISOString()}>{dateLabel(a.data.date)}</time>
            </div>
          </ContentCard>
        ))}
      </ul>
      {hasSamples && (
        <p class="mt-10 text-muted">
          Looking for practical examples? See our{' '}
          <a href="/resources" class="font-semibold text-link underline underline-offset-2">
            sample architectures, procedures and reports
          </a>
          .
        </p>
      )}
    </div>
    <CtaBand />
  </BaseLayout>
)}

<script>
  import '../../scripts/article-toc';
</script>
