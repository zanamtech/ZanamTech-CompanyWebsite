---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ArticleBody from '../../components/sections/ArticleBody.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Badge from '../../components/ui/Badge.astro';
import { isVisible } from '../../lib/content';

// Proof-by-artefact pages (spec 002 §E). Always labelled "Sample"; drafts render in `astro dev` only.
export async function getStaticPaths() {
  const artefacts = await getCollection('resources', isVisible);
  return artefacts.map((artefact) => ({ params: { slug: artefact.id }, props: { artefact } }));
}

interface Props {
  artefact: CollectionEntry<'resources'>;
}

const { artefact } = Astro.props;
const { Content } = await render(artefact);
const title = artefact.data.title.replace(/^Sample:\s*/, '');
---

<BaseLayout title={`Sample: ${title}`} description={artefact.data.summary}>
  <PageHero
    eyebrow="Sample"
    title={title}
    lead={artefact.data.summary}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Samples' }, { label: title }]}
  />
  <article class="container-page section-y">
    <div class="mb-6 flex flex-wrap gap-2">
      <Badge tone="accent">Sample</Badge>
      {artefact.data.draft && <Badge>Draft</Badge>}
    </div>
    <ArticleBody>
      <Content />
    </ArticleBody>
  </article>
  <CtaBand />
</BaseLayout>
