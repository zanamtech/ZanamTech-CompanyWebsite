---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path-relative or absolute Open Graph image URL. */
  image?: string;
  noindex?: boolean;
}

const { title, description = site.description, image = '/apple-touch-icon.png', noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Cookieless, privacy-first analytics (Plausible-compatible); loads only when both values are configured.
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description: site.description,
  email: site.email,
  knowsAbout: [
    'Cloud Migration',
    'Kubernetes',
    'Web Application Firewall',
    'Zero-Trust Security',
    'Disaster Recovery',
    'CI/CD',
    'Observability',
    'Cloud Cost Optimization',
    'Private LLM',
    'Managed Infrastructure',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the stored theme before first paint; light is the default (research R5). -->
    <script is:inline>
      try {
        if (localStorage.getItem('zt-theme') === 'dark') document.documentElement.classList.add('dark');
      } catch (_) {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {analyticsDomain && analyticsSrc && <script is:inline defer data-domain={analyticsDomain} src={analyticsSrc} />}
  </head>
  <body class="bg-bg text-fg">
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-lg bg-cta px-4 py-3 text-sm font-semibold text-cta-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
    <ContactModal />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
