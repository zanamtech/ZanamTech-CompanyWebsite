---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import { pagePath } from '../lib/url';
import { ogImage } from '../lib/og';
import {
  breadcrumbs as breadcrumbList,
  graph,
  organization,
  website,
  type Crumb,
  type SchemaNode,
} from '../lib/schema';
import { PUBLIC_ANALYTICS_DOMAIN, PUBLIC_ANALYTICS_SRC } from 'astro:env/server';
// Preloading the Latin variable font lets text render in the final face, so long headings don't reflow (CLS).
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The page's visible breadcrumb trail, repeated as a BreadcrumbList in the JSON-LD graph. */
  breadcrumbs?: Crumb[];
  /** The page's own schema.org node (a Service or an Article), added to the JSON-LD graph. */
  jsonLd?: SchemaNode;
  /** Articles: `og:type=article` with published and modified times. */
  article?: { published: Date; modified: Date };
}

const { title, description = site.metaDescription, noindex = false, breadcrumbs, jsonLd, article } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const base = new URL('/', Astro.site);
const canonical = new URL(pagePath(Astro.url), Astro.site);
const ogImageUrl = new URL(ogImage.path, Astro.site);

// Cookieless, privacy-first analytics (Plausible-compatible); loads only when both values are configured.
const analyticsDomain = PUBLIC_ANALYTICS_DOMAIN;
const analyticsSrc = PUBLIC_ANALYTICS_SRC;

// One JSON-LD graph per page (audit F-42): Organization, WebSite, the breadcrumbs, and the page's own node.
const structuredData = graph([
  organization(base),
  website(base),
  ...(breadcrumbs?.length ? [breadcrumbList(breadcrumbs, canonical, base)] : []),
  ...(jsonLd ? [jsonLd] : []),
]);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        <meta property="article:modified_time" content={article.modified.toISOString()} />
      </>
    )}
    {/* summary_large_image needs the 1200×630 card (public/og/default.png); the square icon fallback stays summary. */}
    <meta name="twitter:card" content={ogImage.large ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Apply the stored theme before first paint; light is the default (research R5). -->
    <script is:inline>
      try {
        if (localStorage.getItem('zt-theme') === 'dark') document.documentElement.classList.add('dark');
      } catch (_) {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {analyticsDomain && analyticsSrc && <script is:inline defer data-domain={analyticsDomain} src={analyticsSrc} />}
  </head>
  <body class="bg-bg text-fg">
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-lg bg-cta px-4 py-3 text-sm font-semibold text-cta-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/input-modality';
      import '../scripts/reveal';
      import '../scripts/faq-accordion';
    </script>
  </body>
</html>
