---
import { Quote } from 'lucide-react';
import { testimonials } from '../../data/testimonials';
import { verifiedOnly } from '../../lib/content';

// Real, permissioned quotes only (ADR-003). With none, nothing is rendered at all.
const quotes = verifiedOnly(testimonials);
---

{quotes.length > 0 && (
  <section id="testimonials" aria-labelledby="testimonials-title" class="container-page section-y">
    <div class="max-w-2xl">
      <p class="eyebrow">In their words</p>
      <h2 id="testimonials-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
        What clients say
      </h2>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {quotes.map((t) => (
        <li data-testimonial class="glass card-hover flex flex-col rounded-2xl p-6 sm:p-7">
          <Quote aria-hidden="true" className="size-6 text-brand-cyan" />
          <blockquote class="mt-4 text-fg">{t.quote}</blockquote>
          <p class="mt-auto pt-5 text-sm font-semibold text-muted">{t.attribution}</p>
        </li>
      ))}
    </ul>
  </section>
)}
