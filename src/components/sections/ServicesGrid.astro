---
import { ArrowRight } from 'lucide-react';
import ServiceCard from './ServiceCard.astro';
import { getActiveServices } from '../../lib/services';

const services = await getActiveServices();
---

<section id="core-services" aria-labelledby="services-title" class="container-page section-y scroll-mt-12.5 sm:scroll-mt-9.5 lg:scroll-mt-5.5">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="eyebrow">Core services</p>
      <h2 id="services-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
        Cloud, DevOps, web and AI engineering, scoped to your platform
      </h2>
      <p class="mt-4 text-lg text-muted">
        From managed operations and migrations to SaaS builds and practical AI automation, every engagement runs on a
        written Statement of Work.
      </p>
    </div>
    <a
      href="/services"
      class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline"
    >
      View all services
      <ArrowRight aria-hidden="true" className="size-4" />
    </a>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {services.map((service) => <ServiceCard service={service} />)}
  </ul>
</section>
