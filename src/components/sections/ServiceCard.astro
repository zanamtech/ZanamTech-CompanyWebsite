---
import { ArrowRight, CircleCheck } from 'lucide-react';
import Icon from '../ui/Icon.astro';
import { serviceHref, type Service } from '../../lib/services';

interface Props {
  service: Service;
  headingLevel?: 'h3';
  /** Show the catalogue number (off for related-service cards). */
  numbered?: boolean;
  /** 'feature': a full-width horizontal card with an "included" list (a pillar with a single service). */
  layout?: 'card' | 'feature';
  /** Items listed on the feature layout. */
  included?: string[];
}

const { service, numbered = true, layout = 'card', included = [] } = Astro.props;
const feature = layout === 'feature';
const { name, icon, summary, outcome, order } = service.data;
---

<li
  data-service-card
  data-layout={layout}
  class:list={[
    'glass card-hover group relative rounded-2xl p-6 focus-within:border-accent/50 sm:p-7',
    feature ? 'grid gap-6 lg:grid-cols-2 lg:gap-10 lg:p-8' : 'flex flex-col',
  ]}
>
  <div class:list={[feature && 'flex flex-col']}>
  <div class="flex items-start justify-between gap-4">
    <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
      <Icon name={icon} class="size-6" />
    </span>
    {numbered && <span class="text-sm font-semibold text-muted tabular-nums transition-colors duration-300 group-hover:text-accent" aria-hidden="true">{String(order).padStart(2, '0')}</span>}
  </div>

  <h3 class="mt-5 text-lg font-semibold text-fg">
    <a href={serviceHref(service)} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">
      {name}
    </a>
  </h3>
  <p class="mt-2 text-muted">{summary}</p>
  {feature && <div class="flex-1"></div>}
  </div>

  {
    feature && included.length > 0 && (
      <div class="lg:border-l lg:border-border lg:pl-10">
        <p class="text-sm font-semibold text-fg">Included in every retainer</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {included.map((item) => (
            <li class="flex gap-2 text-sm text-fg">
              <CircleCheck aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-brand-cyan" />
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-link" aria-hidden="true">
          Explore service
          <ArrowRight aria-hidden="true" className="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
        </p>
      </div>
    )
  }

  <div class:list={['mt-auto pt-6', feature && 'hidden']}>
    <p class="rounded-lg border border-border bg-surface-2/70 px-3 py-2 text-sm text-fg">
      <span class="font-semibold text-accent">Outcome:</span>{' '}
      {outcome}
    </p>
    <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-link" aria-hidden="true">
      Explore service
      <ArrowRight aria-hidden="true" className="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
    </p>
  </div>
</li>

<style>
  /* Stretched-link focus ring drawn on the card, since the link itself is visually the title. */
  li:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
</style>
