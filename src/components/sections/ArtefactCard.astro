---
import { ArrowRight } from 'lucide-react';
import Badge from '../ui/Badge.astro';
import Illustration from '../ui/Illustration.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  artefact: CollectionEntry<'resources'>;
  /** h3 under a section heading (home band); h2 directly under the page H1 (/resources). */
  headingLevel?: 2 | 3;
}

const { artefact, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const { title, summary, draft } = artefact.data;
---

<li data-artefact class="glass card-hover group relative flex flex-col rounded-2xl p-6 sm:p-7">
  <div class="mb-5 overflow-hidden rounded-xl border border-border">
    <Illustration topic={artefact.id} />
  </div>
  <div class="flex flex-wrap gap-2">
    <Badge tone="accent">Sample</Badge>
    {draft && <Badge>Draft</Badge>}
  </div>
  <Heading class="mt-4 text-lg font-semibold text-fg">
    <a href={`/resources/${artefact.id}`} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">
      {title.replace(/^Sample:\s*/, '')}
    </a>
  </Heading>
  <p class="mt-2 text-sm text-muted">{summary}</p>
  <p class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-link" aria-hidden="true">
    View sample
    <ArrowRight aria-hidden="true" className="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
  </p>
</li>

<style>
  li:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
</style>
