---
import GlassCard from '../ui/GlassCard.astro';

interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

<!-- Long-form document layout: the same typography and "On this page" table of contents as the Privacy Notice. -->
<div class="container-page section-y">
  <div class="privacy-doc space-y-14 text-muted [&_section]:max-w-5xl [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-fg [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-fg [&_li]:pl-1 [&_p]:mt-4 [&_p]:leading-relaxed [&_section]:scroll-mt-28 sm:[&_section]:scroll-mt-32 [&_strong]:font-semibold [&_strong]:text-fg [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ul]:marker:text-accent">
    <GlassCard as="div" class="w-full max-w-full p-6! sm:p-8!">
      <nav aria-labelledby="toc-title">
        <p id="toc-title" class="eyebrow">
          On this page
        </p>
        <ol class="mt-4! grid list-none! grid-cols-1 gap-3 pl-0! sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
          {sections.map((s, i) => (
            <li class="pl-0!">
              <a
                href={`#${s.id}`}
                class="group flex min-h-11 items-center gap-3 text-sm font-medium text-fg transition-colors hover:text-accent"
              >
                <span class="w-6 text-muted tabular-nums transition-colors group-hover:text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </GlassCard>

    <slot />
  </div>
</div>
