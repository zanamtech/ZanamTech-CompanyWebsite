---
import IconTile from '../ui/IconTile.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import GlassCard from '../ui/GlassCard.astro';
import { brandPillars } from '../../data/pillars';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const {
  id = 'pillars',
  eyebrow = 'Why ZanamTech',
  title = 'Pragmatic engineering for systems that cannot fail',
  lead = 'We favor verified engineering outcomes over technology hype: resilient infrastructure, hardened perimeters and privacy-compliant AI, delivered as one accountable partner.',
} = Astro.props;
---

<!-- The three brand-pillar cards. Reused as-is by TrustBand (Constitution IV: reuse, never redraw). -->
<section id={id} aria-labelledby={`${id}-title`} class="container-page section-y">
  <SectionHeader eyebrow={eyebrow} title={title} titleId={`${id}-title`} lead={lead} />

  <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group data-reveal-distance="24">
    {brandPillars.map(({ label, icon, body }) => (
      <GlassCard
        as="li"
        class="cursor-default transition-[translate,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent/60 hover:shadow-xl hover:shadow-purple-500/10 motion-reduce:hover:translate-y-0"
      >
        <IconTile>
          <Icon name={icon} class="size-6" />
        </IconTile>
        <h3 class="mt-5 text-lg font-semibold text-fg">{label}</h3>
        <p class="mt-2 text-muted">{body}</p>
      </GlassCard>
    ))}
  </ul>

  <slot />
</section>
