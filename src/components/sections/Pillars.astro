---
import { Building2, Activity, ShieldCheck } from 'lucide-react';
import GlassCard from '../ui/GlassCard.astro';

const pillars = [
  {
    Icon: Building2,
    title: 'Enterprise-grade',
    body: 'Architecture, delivery and governance built to the standards of regulated, high-scale organizations, with direct access to senior engineers.',
  },
  {
    Icon: Activity,
    title: 'High-availability',
    body: 'Multi-zone orchestration, cross-region replication and automated failover engineered to keep critical workloads online.',
  },
  {
    Icon: ShieldCheck,
    title: 'Zero-trust security',
    body: 'Every request verified. WAF hardening, rate limiting, geo-fencing and encrypted transport across all public endpoints.',
  },
];
---

<section aria-labelledby="pillars-title" class="container-page section-y">
  <div class="max-w-2xl">
    <p class="eyebrow">Why ZanamTech</p>
    <h2 id="pillars-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
      Pragmatic engineering for systems that cannot fail
    </h2>
    <p class="mt-4 text-lg text-muted">
      We favour verified engineering outcomes over technology hype: resilient infrastructure, hardened perimeters and
      privacy-compliant AI, delivered as one accountable partner.
    </p>
  </div>

  <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group data-reveal-stagger="0.1" data-reveal-distance="24">
    {
      pillars.map(({ Icon, title, body }) => (
        <GlassCard
          as="li"
          class="transition-[translate,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent/60 hover:shadow-xl hover:shadow-purple-500/10 motion-reduce:hover:translate-y-0"
        >
          <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
            <Icon aria-hidden="true" className="size-6" strokeWidth={2} />
          </span>
          <h3 class="mt-5 text-lg font-semibold text-fg">{title}</h3>
          <p class="mt-2 text-muted">{body}</p>
        </GlassCard>
      ))
    }
  </ul>
</section>
