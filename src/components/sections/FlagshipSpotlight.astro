---
import CheckList from '../ui/CheckList.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import GlassCard from '../ui/GlassCard.astro';
import { getFlagship, serviceHref } from '../../lib/services';
import { tiers } from '../../data/managed-tiers';

const flagship = await getFlagship();
const { name, summary, capabilities } = flagship.data;
// Module titles only ("Cloud operations: …" → "Cloud operations") keep the teaser scannable.
const modules = capabilities.map((c) => c.split(':')[0]);
---

<!-- Flagship spotlight (spec 002 US1). Composed from GlassCard, Badge and Button with the standard reveal. -->
<!-- anchor-section: the eyebrow lands 24px below the floating header when the hero scroll cue scrolls here. -->
<section id="flagship" aria-labelledby="flagship-title" class="container-page section-y anchor-section">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
    <SectionHeader
      eyebrow="Flagship service"
      title={name}
      titleId="flagship-title"
      lead={summary}
      class="lg:col-span-6"
    >
      <CheckList
        items={modules}
        class="mt-8 grid gap-3 sm:grid-cols-2"
        itemClass="flex gap-2.5 text-fg"
        icon="md"
        wrap
        data-reveal-group=""
        data-reveal-distance="12"
      />
      <div class="mt-10">
        <Button href={serviceHref(flagship)} variant="secondary">
          Explore {name}
          <ArrowRight aria-hidden="true" class="size-4" />
        </Button>
      </div>
    </SectionHeader>

    <ul class="space-y-4 lg:col-span-6" aria-label="Retainer tiers" data-reveal-group data-reveal-distance="24">
      {tiers.map((t) => (
        <GlassCard as="li" class:list={['card-hover relative', t.featured && 'border-accent/50']}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-lg font-semibold text-fg">{t.name}</h3>
            {t.featured && <Badge tone="accent">Recommended</Badge>}
          </div>
          <p class="mt-1 text-sm font-medium text-accent">{t.coverage}</p>
          <p class="mt-3 text-sm text-muted">{t.includes.slice(0, 4).join(' · ')}</p>
        </GlassCard>
      ))}
    </ul>
  </div>
</section>
