---
import CheckList from '../ui/CheckList.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import { AGENCY_PARTNERSHIP_SLUG } from '../../lib/lead';

const points = [
  'White-label or co-branded: you keep the client relationship',
  'Environments, pipelines and hosting set up for each client project',
  'Managed operations after launch, reported to you',
  'Mutual NDA and non-solicitation from the first conversation',
];
---

<!-- Agency partnership model (spec 002 FR-023). -->
<section id="agencies" aria-labelledby="agencies-title" class="container-page section-y">
  <GlassCard class="relative overflow-hidden p-8! sm:p-10!">
    <div class="hairline-gradient absolute inset-x-10 top-0" aria-hidden="true"></div>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <SectionHeader
        eyebrow="For software agencies"
        title="Your DevOps partner, behind your brand"
        titleId="agencies-title"
        lead="You win the application work; we run the cloud and delivery platform behind it. Every project gets reliable environments, pipelines and operations, without you hiring a platform team."
        leadSize="base"
        size="md"
        class="lg:col-span-6"
      >
        <div class="mt-8">
          <Button href={`/contact?service=${AGENCY_PARTNERSHIP_SLUG}`}>
            Discuss an agency partnership
            <ArrowRight aria-hidden="true" class="size-4" />
          </Button>
        </div>
      </SectionHeader>
      <CheckList items={points} class="space-y-3 lg:col-span-6" itemClass="flex gap-2.5 text-fg" icon="md" />
    </div>
  </GlassCard>
</section>
