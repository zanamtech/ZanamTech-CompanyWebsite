---
import { ArrowRight, CircleCheck } from 'lucide-react';
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import { AGENCY_PARTNERSHIP_SLUG } from '../../lib/lead';

const points = [
  'White-label or co-branded: you keep the client relationship',
  'Environments, pipelines and hosting set up for each client project',
  'Managed operations after launch, reported to you',
  'Mutual NDA and non-solicitation from the first conversation',
];
---

<!-- Agency partnership model (spec 002 FR-023). -->
<section id="agencies" aria-labelledby="agencies-title" class="container-page section-y">
  <GlassCard class="relative overflow-hidden p-8! sm:p-10!">
    <div class="hairline-gradient absolute inset-x-10 top-0" aria-hidden="true"></div>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <p class="eyebrow">For software agencies</p>
        <h2 id="agencies-title" class="mt-3 text-3xl font-bold text-fg">Your DevOps partner, behind your brand</h2>
        <p class="mt-4 text-muted">
          You win the application work; we run the cloud and delivery platform behind it. Every project gets reliable
          environments, pipelines and operations, without you hiring a platform team.
        </p>
        <div class="mt-8">
          <Button href={`/contact?service=${AGENCY_PARTNERSHIP_SLUG}`} data-service={AGENCY_PARTNERSHIP_SLUG}>
            Discuss an agency partnership
            <ArrowRight aria-hidden="true" className="size-4" />
          </Button>
        </div>
      </div>
      <ul class="space-y-3 lg:col-span-6">
        {
          points.map((p) => (
            <li class="flex gap-2.5 text-fg">
              <CircleCheck aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-brand-cyan" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </GlassCard>
</section>
