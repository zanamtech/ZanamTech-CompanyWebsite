---
import SectionHeader from '../ui/SectionHeader.astro';
import { getCollection } from 'astro:content';
import ArtefactCard from '../cards/ArtefactCard.astro';
import { isVisible } from '../../lib/content';

// Proof by artefact (spec 002 §E). Only visible entries render; drafts appear in `astro dev` only, so this band is
// absent from builds until the owner approves at least one artefact.
const artefacts = (await getCollection('resources', isVisible)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

{artefacts.length > 0 && (
  <section id="artefacts" aria-labelledby="artefacts-title" class="container-page section-y">
    <SectionHeader
      eyebrow="How we document work"
      title="See the standard before you sign"
      titleId="artefacts-title"
      lead="Samples of the architecture, procedures and reporting every engagement produces. Written for illustration, not taken from any client."
    />
    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {artefacts.map((artefact) => (
        <ArtefactCard artefact={artefact} />
      ))}
    </ul>
  </section>
)}
