---
import IconTile from '../ui/IconTile.astro';
import { pad2 } from '../../lib/format';
import SectionHeader from '../ui/SectionHeader.astro';
import { ArrowRight } from '@lucide/astro';
import Icon from '../ui/Icon.astro';
import { getServicesByPillar, pillarHref, serviceHref } from '../../lib/services';
import { flagshipIncluded } from '../../data/managed-tiers';

const pillars = await getServicesByPillar();
---

<!-- Service pillars (spec 002 FR-008). Reuses the ServiceCard surface, icon tile and card-hover lift. -->
<section id="core-services" aria-labelledby="services-title" class="container-page section-y anchor-section">
  <SectionHeader
    eyebrow="Services"
    title="Cloud, DevOps, web and AI engineering, scoped to your platform"
    titleId="services-title"
    lead="From managed operations and migrations to SaaS builds and practical AI automation, every engagement runs on a written Statement of Work."
    link={{ href: '/services', label: 'View all services' }}
  />

  <ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4" data-reveal-group>
    {pillars.map((p) => (
      <li data-pillar={p.pillar} class="glass card-hover group flex flex-col rounded-2xl p-6 sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <IconTile>
            <Icon name={p.icon} class="size-6" />
          </IconTile>
          <span
            class="text-sm font-semibold text-muted tabular-nums transition-colors duration-300 group-hover:text-accent"
            aria-hidden="true"
          >
            {pad2(p.order)}
          </span>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-fg">
          <a href={pillarHref(p.pillar)} class="hover:text-accent">
            {p.title}
          </a>
        </h3>
        <p class="mt-2 text-sm text-muted">{p.description}</p>
        {/* A single-service pillar (Managed) lists what the retainer includes, each linking to the flagship page,
              instead of one link repeating the pillar name. */}
        <ul class="mt-5 space-y-1 border-t border-border pt-4">
          {p.services.length === 1
            ? flagshipIncluded.map((item) => (
                <li>
                  <a
                    href={serviceHref(p.services[0])}
                    class="inline-flex min-h-9 items-center gap-1.5 text-sm font-medium text-fg hover:text-accent"
                  >
                    <ArrowRight aria-hidden="true" class="size-3.5 shrink-0 text-muted" />
                    {item}
                  </a>
                </li>
              ))
            : p.services.map((s) => (
                <li>
                  <a
                    href={serviceHref(s)}
                    class="inline-flex min-h-9 items-center gap-1.5 text-sm font-medium text-fg hover:text-accent"
                  >
                    <ArrowRight aria-hidden="true" class="size-3.5 shrink-0 text-muted" />
                    {s.data.name}
                  </a>
                </li>
              ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
