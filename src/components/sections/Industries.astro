---
import { ArrowRight } from 'lucide-react';
import Icon from '../ui/Icon.astro';
import { segments } from '../../data/segments';
---

<section id="industries" aria-labelledby="industries-title" class="border-y border-border bg-surface/60">
  <div class="container-page py-20 sm:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Who we serve</p>
        <h2 id="industries-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
          Built for organizations that cannot compromise on reliability
        </h2>
      </div>
      <a href="/industries" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline">
        Industries we serve
        <ArrowRight aria-hidden="true" className="size-4" />
      </a>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
      {
        segments.map((s) => (
          <li data-segment class="glass rounded-2xl p-6 sm:p-7">
            <span class="flex size-12 items-center justify-center rounded-xl bg-brand-cyan/12 text-brand-cyan">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-fg">{s.name}</h3>
            <p class="mt-2 text-sm text-muted">{s.profile}</p>
            <p class="mt-5 text-sm font-semibold text-fg">Decision makers</p>
            <p class="mt-1 text-sm text-muted">{s.decisionMakers.join(' · ')}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
