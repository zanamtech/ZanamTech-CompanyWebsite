---
import IconTile from '../ui/IconTile.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { segments } from '../../data/segments';
---

<section id="industries" aria-labelledby="industries-title" class="border-y border-border bg-surface/60">
  <div class="container-page section-y">
    <SectionHeader
      eyebrow="Who we serve"
      title="Built for organizations that cannot compromise on reliability"
      titleId="industries-title"
      link={{ href: '/industries', label: 'Industries we serve' }}
    />

    <ul
      class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4"
      data-reveal-group
      data-reveal-distance="0"
      data-reveal-scale="0.95"
    >
      {segments.map((s) => (
        <li
          data-segment
          class="glass cursor-default rounded-2xl p-6 transition-[translate,box-shadow,border-color] duration-300 ease-out hover:-translate-y-2 hover:border-accent/50 hover:shadow-xl hover:shadow-purple-500/15 sm:p-7 motion-reduce:hover:translate-y-0"
        >
          <IconTile>
            <Icon name={s.icon} class="size-6" />
          </IconTile>
          <h3 class="mt-5 text-lg font-semibold text-fg">{s.name}</h3>
          <p class="mt-2 text-sm text-muted">{s.profile}</p>
          <p class="mt-5 text-sm font-semibold text-fg">Decision makers</p>
          <p class="mt-1 text-sm text-muted">{s.decisionMakers.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
