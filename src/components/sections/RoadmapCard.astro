---
import { CircleDashed } from 'lucide-react';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';
import type { Service } from '../../lib/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { name, icon, summary, capabilities } = service.data;
---

<article
  data-roadmap
  aria-labelledby={`roadmap-${service.id}`}
  class="relative grid gap-8 rounded-3xl border border-dashed border-border-strong bg-surface/50 p-6 sm:p-10 lg:grid-cols-12"
>
  <div class="lg:col-span-5">
    <div class="flex items-center gap-3">
      <span class="flex size-12 items-center justify-center rounded-xl bg-surface-2 text-muted">
        <Icon name={icon} class="size-6" />
      </span>
      <Badge tone="accent">In Development</Badge>
    </div>
    <h3 id={`roadmap-${service.id}`} class="mt-5 text-2xl font-bold text-fg">{name}</h3>
    <p class="mt-3 text-muted">{summary}</p>
  </div>
  <div class="lg:col-span-7">
    <p class="text-sm font-semibold text-fg">Planned capabilities</p>
    <ul class="mt-4 space-y-3">
      {
        capabilities.map((c) => (
          <li class="flex gap-2 text-fg">
            <CircleDashed aria-hidden="true" className="mt-1 size-4 shrink-0 text-muted" />
            {c}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-muted">
      This offering is on our technology roadmap and is not yet available for engagement.
    </p>
  </div>
</article>
