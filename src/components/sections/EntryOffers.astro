---
import { ArrowRight } from 'lucide-react';
import OfferCard from './OfferCard.astro';
import { offers } from '../../data/offers';

interface Props {
  detailed?: boolean;
  /** Hide the section intro when the page hero already introduces the offers. */
  withIntro?: boolean;
}

const { detailed = false, withIntro = true } = Astro.props;
---

<!-- Entry offers (spec 002 FR-022): fixed scope, fee never shown. -->
<section
  id="start-here"
  aria-labelledby={withIntro ? 'offers-title' : undefined}
  aria-label={withIntro ? undefined : 'Entry offers'}
  class:list={['container-page', withIntro ? 'section-y' : 'section-b pt-8']}
>
  {
    withIntro && (
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Start here</p>
          <h2 id="offers-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
            Low-risk ways to start
          </h2>
          <p class="mt-4 text-lg text-muted">
            Fixed-scope engagements with a clear output, so you can judge the fit before committing to a larger project
            or retainer.
          </p>
        </div>
        {!detailed && (
          <a href="/start-here" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline">
            See every entry offer
            <ArrowRight aria-hidden="true" className="size-4" />
          </a>
        )}
      </div>
    )
  }

  <ul class:list={['grid gap-6 md:grid-cols-2 lg:grid-cols-3', withIntro && 'mt-12']} data-reveal-group>
    {offers.map((offer) => <OfferCard offer={offer} detailed={detailed} headingLevel={withIntro ? 'h3' : 'h2'} />)}
  </ul>
</section>
