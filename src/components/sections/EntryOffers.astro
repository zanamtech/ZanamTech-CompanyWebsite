---
import IconTile from '../ui/IconTile.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { ArrowRight } from '@lucide/astro';
import OfferCard from '../cards/OfferCard.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { offers } from '../../data/offers';

interface Props {
  detailed?: boolean;
  /** Hide the section intro when the page hero already introduces the offers. */
  withIntro?: boolean;
  /** One-row strip (offer names + durations) linking to /start-here; the full cards live only on /start-here. */
  compact?: boolean;
}

const { detailed = false, withIntro = true, compact = false } = Astro.props;
---

<!-- Entry offers (spec 002 FR-022): fixed scope, fee never shown. -->
{compact ? (
  <section id="start-here" aria-labelledby="offers-title" class="container-page section-y">
    <SectionHeader
      eyebrow="Start here"
      title="Low-risk ways to start"
      titleId="offers-title"
      lead="Fixed scope, a clear written output, no long-term commitment."
      link={{ href: '/start-here', label: 'See all entry offers' }}
      linkGap={4}
    />
    {/* ≥1280px: five in one row. 768–1279px: 3 + 2 centred. Phones: a horizontal scroll-snap row that shows part of
          the next card. Each whole card links to its offer on /start-here. */}
    <ul
      class="mt-10 -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pt-1 pb-3 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:flex-wrap md:justify-center md:gap-6 md:overflow-visible md:px-0 md:pb-0 xl:flex-nowrap"
      data-offer-strip
    >
      {offers.map((offer) => (
        <li class="w-[78%] shrink-0 snap-start sm:w-[45%] md:w-[calc((100%-3rem)/3)] xl:w-auto xl:min-w-0 xl:flex-1">
          <a
            href={`/start-here#${offer.id}`}
            class="glass card-hover group flex h-full flex-col rounded-2xl p-5"
            data-offer-card={offer.id}
          >
            <IconTile size={10}>
              <Icon name={offer.icon} class="size-5" />
            </IconTile>
            <span class="mt-4 text-base font-semibold text-fg group-hover:text-accent">{offer.name}</span>
            <Badge tone="accent" class="mt-2 self-start">
              {offer.duration}
            </Badge>
            <span class="mt-3 text-sm text-muted">{offer.output}</span>
            <span
              class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-link"
              aria-hidden="true"
            >
              View offer
              <ArrowRight
                aria-hidden="true"
                class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
              />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
) : (
  <section
    id="start-here"
    aria-labelledby={withIntro ? 'offers-title' : undefined}
    aria-label={withIntro ? undefined : 'Entry offers'}
    class:list={['container-page', withIntro ? 'section-y' : 'section-b pt-8']}
  >
    {withIntro && (
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeader
          eyebrow="Start here"
          title="Low-risk ways to start"
          titleId="offers-title"
          lead="Fixed-scope engagements with a clear output, so you can judge the fit before committing to a larger project or retainer."
        />
        {!detailed && <ArrowLink href="/start-here" class="shrink-0" label="See every entry offer" />}
      </div>
    )}

    <ul class:list={['cards-centred', withIntro && 'mt-12']} data-reveal-group>
      {offers.map((offer) => (
        <OfferCard offer={offer} detailed={detailed} headingLevel={withIntro ? 'h3' : 'h2'} />
      ))}
    </ul>
  </section>
)}
