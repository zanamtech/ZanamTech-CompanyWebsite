---
import { ArrowRight, CircleCheck } from 'lucide-react';
import { engagementPhases } from '../../data/engagement';

interface Props {
  /** Show per-phase detail lists (Approach page). */
  detailed?: boolean;
  /** Show the section intro (Home page). */
  withIntro?: boolean;
}

const { detailed = false, withIntro = true } = Astro.props;
---

<section id="process" aria-labelledby={withIntro ? 'process-title' : undefined} aria-label={withIntro ? undefined : 'Engagement phases'} class:list={['container-page', withIntro ? 'py-20 sm:py-24' : 'pt-10 pb-20']}>
  {
    withIntro && (
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">How we engage</p>
          <h2 id="process-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
            A consultative process built for enterprise accountability
          </h2>
          <p class="mt-4 text-lg text-muted">
            No fixed packages or commodity rates. Every engagement begins with an architectural assessment and is
            governed by a Statement of Work.
          </p>
        </div>
        <a href="/approach" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline">
          Our approach
          <ArrowRight aria-hidden="true" className="size-4" />
        </a>
      </div>
    )
  }

  <div class:list={['relative', withIntro && 'mt-12']}>
  <div class="hairline-gradient absolute inset-x-8 top-9 hidden lg:block" aria-hidden="true"></div>
  <ol class="relative grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {
      engagementPhases.map((phase) => (
        <li data-phase class="glass relative flex flex-col rounded-2xl p-6">
          <span class="flex size-12 items-center justify-center rounded-xl bg-cta text-sm font-bold text-cta-fg shadow-sm">
            {String(phase.order).padStart(2, '0')}
          </span>
          <h3 class="mt-5 text-lg font-semibold text-fg">{phase.name}</h3>
          <p class="mt-2 text-sm text-muted">{phase.summary}</p>
          {detailed && (
            <ul class="mt-5 space-y-2 border-t border-border pt-5">
              {phase.details.map((d) => (
                <li class="flex gap-2 text-sm text-fg">
                  <CircleCheck aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-brand-cyan" />
                  {d}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
  </div>
</section>
