---
import { ArrowRight, CircleCheck } from 'lucide-react';
import { engagementPhases } from '../../data/engagement';

interface Props {
  /** Show per-phase detail lists (Approach page). */
  detailed?: boolean;
  /** Show the section intro (Home page). */
  withIntro?: boolean;
}

const { detailed = false, withIntro = true } = Astro.props;
---

<section id="process" aria-labelledby={withIntro ? 'process-title' : undefined} aria-label={withIntro ? undefined : 'Engagement phases'} class:list={['container-page overflow-x-clip', withIntro ? 'section-y' : 'pt-8 pb-12 sm:pb-16 lg:pb-20']}>
  {
    withIntro && (
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">How we engage</p>
          <h2 id="process-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
            A consultative process built for enterprise accountability
          </h2>
          <p class="mt-4 text-lg text-muted">
            No fixed packages or commodity rates. Every engagement begins with an architectural assessment and is
            governed by a Statement of Work.
          </p>
        </div>
        <a href="/approach" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline">
          How we work
          <ArrowRight aria-hidden="true" className="size-4" />
        </a>
      </div>
    )
  }

  <div class:list={['relative', withIntro && 'mt-12']} x-data={`processReveal(${engagementPhases.length})`}>
  <ol class="relative grid gap-(--process-gap) [--process-gap:--spacing(6)] md:grid-cols-2 lg:grid-cols-4 lg:[--process-gap:--spacing(10)]">
    {
      engagementPhases.map((phase) => (
        <li
          data-phase
          class="relative flex data-[shown=true]:transition-all data-[shown=true]:duration-700 data-[shown=true]:ease-out data-[shown=false]:pointer-events-none data-[shown=false]:translate-x-16 data-[shown=false]:opacity-0"
          x-bind:data-shown={`isShown(${phase.order})`}
        >
          <div class="glass card-hover relative flex w-full cursor-default select-none flex-col rounded-2xl p-6">
            <span class="flex size-12 items-center justify-center rounded-xl bg-cta text-sm font-bold text-cta-fg shadow-sm">
              {String(phase.order).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-fg">{phase.name}</h3>
            <p class="mt-2 text-sm text-muted">{phase.summary}</p>
            {detailed && (
              <ul class="mt-5 space-y-2 border-t border-border pt-5">
                {phase.details.map((d) => (
                  <li class="flex gap-2 text-sm text-fg">
                    <CircleCheck aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-brand-cyan" />
                    {d}
                  </li>
                ))}
              </ul>
            )}
          </div>
          {/* Connector: lives in the gap after this card (desktop row only), running from its right border to the next
              card's left border. It draws once this card has settled, just before the next card slides in. Without
              JS it renders fully drawn. */}
          {phase.order < engagementPhases.length && (
            <div class="pointer-events-none absolute top-[47px] left-full hidden h-[2px] w-(--process-gap) lg:block" aria-hidden="true">
              <span
                class="block h-full w-full bg-purple-500/80 shadow-[0_0_8px_rgba(168,85,247,0.5)] data-[drawn=true]:transition-[width] data-[drawn=true]:duration-500 data-[drawn=true]:ease-out data-[drawn=false]:w-0 dark:bg-purple-400/80"
                x-bind:data-drawn={`isDrawn(${phase.order})`}
              />
            </div>
          )}
        </li>
      ))
    }
  </ol>
  </div>
</section>
