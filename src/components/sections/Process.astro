---
import { ArrowRight, CircleCheck } from '@lucide/astro';
import { engagementPhases } from '../../data/engagement';

interface Props {
  /** Show per-phase detail lists (Approach page). */
  detailed?: boolean;
  /** Show the section intro (Home page). */
  withIntro?: boolean;
}

const { detailed = false, withIntro = true } = Astro.props;
---

<section
  id="process"
  aria-labelledby={withIntro ? 'process-title' : undefined}
  aria-label={withIntro ? undefined : 'Engagement phases'}
  class:list={['container-page overflow-x-clip', withIntro ? 'section-y' : 'section-b pt-8']}
>
  {withIntro && (
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">How we engage</p>
        <h2 id="process-title" class="mt-3 text-3xl font-bold text-fg sm:text-4xl">
          A consultative process built for enterprise accountability
        </h2>
        <p class="mt-4 text-lg text-muted">
          No fixed packages or commodity rates. Every engagement begins with an architectural assessment and is governed
          by a Statement of Work.
        </p>
      </div>
      <a
        href="/approach"
        class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-link hover:underline"
      >
        How We Work
        <ArrowRight aria-hidden="true" class="size-4" />
      </a>
    </div>
  )}

  {/* One reveal group (src/scripts/reveal.ts): the four cards start 60ms apart, each connector 30ms after its card. The
      items style their own states (data-reveal-custom): each card slides 64px over 700ms, the fade runs on the glass
      card and the connector draws over 500ms. Without JS, under reduced motion and once done, nothing is applied. */}
  <div class:list={['relative', withIntro && 'mt-12']}>
    <ol
      data-reveal-group
      class="relative grid gap-(--process-gap) [--process-gap:--spacing(6)] md:grid-cols-2 lg:grid-cols-4 lg:[--process-gap:--spacing(10)]"
    >
      {engagementPhases.map((phase) => (
        <li
          data-phase
          data-reveal-custom
          class="group/phase relative flex data-[reveal=hidden]:pointer-events-none data-[reveal=hidden]:translate-x-16 data-[reveal=shown]:transition-[translate] data-[reveal=shown]:delay-(--reveal-delay) data-[reveal=shown]:duration-700 data-[reveal=shown]:ease-out"
        >
          {/* The fade runs on the glass card itself, never on an ancestor: an ancestor below opacity 1 becomes the card's
              backdrop root, and browsers can leave the backdrop-filtered card unpainted until something (a hover)
              forces a repaint. The attribute is removed after the sequence, which drops every reveal style. */}
          <div class="glass card-hover relative flex w-full cursor-default select-none flex-col rounded-2xl p-6 group-data-[reveal=hidden]/phase:opacity-0 group-data-[reveal=shown]/phase:transition-[opacity,translate,box-shadow,border-color] group-data-[reveal=shown]/phase:delay-[var(--reveal-delay),0s,0s,0s] group-data-[reveal=shown]/phase:duration-700 group-data-[reveal=shown]/phase:ease-out">
            <span class="flex size-12 items-center justify-center rounded-xl bg-cta text-sm font-bold text-cta-fg shadow-sm">
              {String(phase.order).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-fg">{phase.name}</h3>
            <p class="mt-2 text-sm text-muted">{phase.summary}</p>
            {detailed && (
              <ul class="mt-5 space-y-2 border-t border-border pt-5">
                {phase.details.map((d) => (
                  <li class="flex gap-2 text-sm text-fg">
                    <CircleCheck aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand-cyan" />
                    {d}
                  </li>
                ))}
              </ul>
            )}
          </div>
          {/* Connector: lives in the gap after this card (desktop row only), running from its right border to the next
              card's left border. It draws 30ms after its card starts, just before the next card slides in. Without
              JS it renders fully drawn. */}
          {phase.order < engagementPhases.length && (
            <div
              class="pointer-events-none absolute top-[47px] left-full hidden h-[2px] w-(--process-gap) lg:block"
              aria-hidden="true"
            >
              <span class="block h-full w-full bg-purple-500/80 shadow-[0_0_8px_rgba(168,85,247,0.5)] transition-[width] duration-500 ease-out group-data-[reveal=hidden]/phase:w-0 group-data-[reveal=hidden]/phase:transition-none group-data-[reveal=shown]/phase:delay-[calc(var(--reveal-delay)+30ms)] dark:bg-purple-400/80" />
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
