---
// Maps content-level icon names to Lucide components (@lucide/astro). Rendered at build time as static SVG, no client JS.
import {
  Activity,
  Globe,
  Handshake,
  Layers,
  LayoutDashboard,
  RefreshCw,
  ServerCog,
  Bot,
  BrainCircuit,
  BuildingComplex,
  CodeXml,
  Container,
  DatabaseBackup,
  Headset,
  LockKeyhole,
  Rocket,
  ShieldCheck,
  TrendingDown,
  Workflow,
} from '@lucide/astro';
import type { IconName } from '../../data/ids';

// Typed against the shared list, so a name missing here (or an extra one) fails `astro check`.
const icons: Record<IconName, typeof Activity> = {
  Activity,
  Globe,
  Handshake,
  Layers,
  LayoutDashboard,
  RefreshCw,
  ServerCog,
  Bot,
  BrainCircuit,
  Building2: BuildingComplex,
  CodeXml,
  Container,
  DatabaseBackup,
  Headset,
  LockKeyhole,
  Rocket,
  ShieldCheck,
  TrendingDown,
  Workflow,
};

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className, strokeWidth = 2 } = Astro.props;
const Component = icons[name];
---

<Component aria-hidden="true" class={className} stroke-width={strokeWidth} />
