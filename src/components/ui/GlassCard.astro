---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'article' | 'li' | 'section';
  padded?: boolean;
}

const { as: Tag = 'div', padded = true, class: className, ...rest } = Astro.props;
---

<Tag class:list={['glass rounded-2xl', padded && 'p-6 sm:p-7', className]} {...rest}>
  <slot />
</Tag>
