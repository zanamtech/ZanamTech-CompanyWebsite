---
/** Technology / fact chip in a list (service "Technology stack", About "At a glance"). Renders the <li>. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<li class="cursor-default rounded-full border border-border/60 bg-surface-2/40 px-3.5 py-1.5 text-sm font-medium text-fg/80 backdrop-blur-sm transition-all duration-300 ease-in-out hover:scale-[1.02] hover:border-accent/60 hover:bg-surface-2/70 hover:text-fg hover:shadow-md hover:shadow-purple-500/10 motion-reduce:hover:scale-100">
  {label}
</li>
