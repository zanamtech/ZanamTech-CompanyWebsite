---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Marks the link as a consultation CTA (opens the contact dialog once US3 is wired). */
  contactCta?: boolean;
}

const { href, variant = 'primary', size = 'md', contactCta = false, class: className, ...rest } = Astro.props;

const base =
  'group relative inline-flex min-h-11 items-center justify-center gap-2 overflow-hidden rounded-xl font-semibold no-underline transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-3';
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
};
const variants = {
  primary: 'bg-cta bg-linear-to-r from-cta to-brand-purple text-cta-fg shadow-sm shadow-purple-500/20 hover:from-cta-hover hover:to-cta hover:shadow-md',
  secondary: 'border border-border-strong bg-surface/60 text-fg hover:border-accent hover:text-accent',
  ghost: 'text-fg hover:text-accent',
};
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], className]}
  data-contact-cta={contactCta ? '' : undefined}
  {...rest}
>
  {
    variant === 'primary' && (
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 group-hover:translate-x-full motion-reduce:hidden"
      />
    )
  }
  <span class="relative inline-flex items-center gap-2"><slot /></span>
</a>
