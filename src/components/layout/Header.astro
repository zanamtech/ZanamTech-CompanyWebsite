---
import { ArrowRight, ChevronDown, Menu, X } from 'lucide-react';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { navLinks, cta } from '../../data/site';
import { getActiveServices, serviceGroups, serviceHref, type ServiceGroup } from '../../lib/services';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const services = await getActiveServices();
const groups = (Object.keys(serviceGroups) as ServiceGroup[]).map((key) => ({
  key,
  title: serviceGroups[key].title,
  services: services.filter((s) => s.data.group === key),
}));
const linkClass = (href: string) => [
  'inline-flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium transition-colors duration-150 hover:text-accent',
  isActive(href) ? 'text-accent' : 'text-muted',
];
---

<header
  transition:persist="site-header"
  class="glass-bar sticky top-0 z-40"
  x-data="siteHeader"
  x-on:keydown.escape.window="onEscape()"
>
  <div class="container-page flex h-16 items-center justify-between gap-6 lg:h-18">
    <!-- Trimmed, optimized brand logo (no transparent margin), so it aligns with the page content edge. -->
    <Logo eager height={24} />

    <nav aria-label="Primary" class="hidden lg:flex">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) =>
            link.href === '/services' ? (
              <li
                class="flex items-center"
                x-on:mouseenter="openServices()"
                x-on:mouseleave="closeServicesSoon()"
                x-on:focusin="openServicesOnFocus()"
                x-on:focusout="closeServicesIfFocusLeft($event)"
                x-on:click.outside="services = false"
              >
                <!-- Single trigger: click navigates to /services; hover or keyboard focus reveals the menu. -->
                <a
                  href={link.href}
                  data-nav-link="desktop"
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  aria-controls="services-menu"
                  x-ref="servicesLink"
                  class:list={[...linkClass(link.href), 'gap-1.5']}
                >
                  {link.label}
                  <span class="inline-flex transition-transform duration-200" x-bind:class="services && 'rotate-180'">
                    <ChevronDown aria-hidden="true" className="size-4" />
                  </span>
                </a>

                <div
                  id="services-menu"
                  role="region"
                  aria-label="Services menu"
                  class="absolute top-full left-1/2 mt-2 w-[min(64rem,calc(100vw-4rem))] -translate-x-1/2 rounded-2xl border border-(--glass-border) bg-surface shadow-2xl ring-1 ring-black/5 before:absolute before:inset-x-0 before:-top-7 before:h-7 before:content-['']"
                  x-show="services"
                  x-cloak
                  x-transition.opacity.duration.150ms
                >
                  <div class="hairline-gradient absolute inset-x-6 top-0" aria-hidden="true"></div>
                  <div class="grid grid-cols-[12rem_1fr_1fr] gap-6 p-5">
                    <div class="border-r border-border pr-5">
                      <p class="eyebrow">Services</p>
                      <p class="mt-2 text-base font-semibold text-fg">Enterprise engineering, end to end</p>
                      <p class="mt-1.5 text-sm text-muted">
                        Nine core disciplines, each scoped to measurable targets in a Statement of Work.
                      </p>
                      <a
                        href="/services"
                        class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-link hover:underline"
                      >
                        View all services
                        <ArrowRight aria-hidden="true" className="size-4" />
                      </a>
                    </div>
                    {groups.map((group) => (
                      <div>
                        <p class="px-2 text-xs font-semibold tracking-wide text-muted uppercase">{group.title}</p>
                        <ul class="mt-2">
                          {group.services.map((service) => (
                            <li>
                              <a
                                href={serviceHref(service)}
                                class="group/item flex min-h-11 items-center gap-2.5 rounded-lg px-2 py-1.5 hover:bg-surface-2"
                              >
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-brand-cyan/12 text-brand-cyan">
                                  <Icon name={service.data.icon} class="size-4" />
                                </span>
                                <span class="text-sm font-medium text-fg group-hover/item:text-accent">
                                  {service.data.name}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={link.href} data-nav-link="desktop" aria-current={isActive(link.href) ? 'page' : undefined} class:list={linkClass(link.href)}>
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <div class="hidden lg:block">
        <Button href={cta.href} contactCta>{cta.primary}</Button>
      </div>
      <button
        type="button"
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-fg hover:bg-surface-2 lg:hidden"
        aria-controls="mobile-nav"
        x-ref="menuButton"
        x-bind:aria-expanded="open.toString()"
        aria-expanded="false"
        x-on:click="open = !open"
      >
        <span class="sr-only" x-text="open ? 'Close menu' : 'Open menu'">Open menu</span>
        <span x-show="!open" class="inline-flex"><Menu aria-hidden="true" className="size-6" /></span>
        <span x-show="open" x-cloak class="inline-flex"><X aria-hidden="true" className="size-6" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-border bg-surface lg:hidden"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.150ms
    x-on:click.outside="open = false"
  >
    <ul class="container-page flex flex-col py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link="mobile"
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="flex min-h-12 items-center rounded-lg px-2 text-base font-medium text-fg hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3 pb-2">
        <Button href={cta.href} contactCta class="w-full">{cta.primary}</Button>
      </li>
    </ul>
  </nav>
</header>
