---
import { ArrowRight, ChevronDown, Menu, X } from 'lucide-react';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import MenuServiceLink from './MenuServiceLink.astro';
import { navLinks as allNavLinks, cta } from '../../data/site';
import { getServicesByPillar, serviceHref } from '../../lib/services';
import { hasPublishedInsights, hasVerifiedCaseStudies } from '../../lib/content';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

// Insights and Case Studies appear only when they have published / verified content (spec 002 FR-020, FR-030).
const showInsights = await hasPublishedInsights();
const showCaseStudies = await hasVerifiedCaseStudies();
const navLinks = [
  ...allNavLinks.filter((l) => l.href !== '/insights' || showInsights),
  ...(showCaseStudies ? [{ label: 'Case Studies', href: '/case-studies' }] : []),
];

const groups = await getServicesByPillar();
const pillar = Object.fromEntries(groups.map((g) => [g.pillar, g])) as Record<
  (typeof groups)[number]['pillar'],
  (typeof groups)[number]
>;
// Mega-menu balance: Cloud & DevOps Engineering is split across two sub-columns under one heading.
const cloudSplit = Math.ceil(pillar['cloud-devops'].services.length / 2);
const cloudColumns = [
  pillar['cloud-devops'].services.slice(0, cloudSplit),
  pillar['cloud-devops'].services.slice(cloudSplit),
];
const groupHeading = 'px-2 text-xs font-semibold tracking-wide text-muted uppercase';
const linkClass = (href: string) => [
  'inline-flex min-h-11 items-center rounded-lg px-2.5 text-sm font-medium whitespace-nowrap transition-colors duration-150 hover:text-accent xl:px-3.5',
  isActive(href) ? 'text-accent' : 'text-muted',
];
---

<header
  transition:persist="site-header"
  class="pointer-events-none fixed inset-x-0 top-0 z-40 bg-transparent px-3 pt-2 sm:px-6 sm:pt-3 lg:px-8"
  x-data="siteHeader"
  x-on:keydown.escape.window="onEscape()"
>
  <!-- Once the page is scrolled, a full-width backdrop (same background and blur as the bar) fills the strip from the
       top of the screen to the bar's bottom edge, so no page text shows above or beside the floating bar. -->
  <span
    aria-hidden="true"
    class="header-backdrop pointer-events-none absolute inset-0 -z-10 block opacity-0 transition-opacity duration-200"
    x-bind:class="scrolled && 'opacity-100'"
    data-header-backdrop
  ></span>
  <!-- Floating glass bar over the first section (the wrapper is transparent and click-through).
       `relative` anchors the Services mega-menu directly beneath it. -->
  <div class="pointer-events-auto relative mx-auto flex max-w-7xl items-center justify-between gap-6 header-bar rounded-2xl border border-border/40 px-4 py-2.5 shadow-sm transition-[background-color,border-color,box-shadow] duration-300 sm:px-6">
    <!-- Trimmed, optimized brand logo (no transparent margin), so it aligns with the page content edge. -->
    <Logo eager height={24} />

    <nav aria-label="Primary" class="hidden lg:flex">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) =>
          link.href === '/services' ? (
            <li
              class="flex items-center"
              x-on:pointerdown="rememberPointer($event)"
              x-on:pointerenter="onServicesPointerEnter($event)"
              x-on:pointerleave="onServicesPointerLeave($event)"
              x-on:focusin="openServicesOnFocus()"
              x-on:focusout="closeServicesIfFocusLeft($event)"
              x-on:click.outside="services = false"
            >
              <!-- Single trigger. Mouse: hover reveals the menu, click navigates to /services.
                     Touch/no-hover devices: tap toggles the menu (no navigation); "View all services" inside navigates. -->
              <a
                href={link.href}
                data-nav-link="desktop"
                aria-current={isActive(link.href) ? 'page' : undefined}
                aria-controls="services-menu"
                aria-expanded="false"
                x-bind:aria-expanded="services.toString()"
                x-ref="servicesLink"
                x-on:click="toggleServices($event)"
                class:list={[...linkClass(link.href), 'gap-1.5']}
              >
                {link.label}
                <span class="inline-flex transition-transform duration-200" x-bind:class="services && 'rotate-180'">
                  <ChevronDown aria-hidden="true" className="size-4" />
                </span>
              </a>

              <div
                id="services-menu"
                role="region"
                aria-label="Services menu"
                class="absolute top-full left-1/2 mt-2 w-[min(72rem,calc(100vw-3rem))] -translate-x-1/2 rounded-2xl border border-(--glass-border) bg-surface shadow-2xl ring-1 ring-black/5 before:absolute before:inset-x-0 before:-top-7 before:h-7 before:content-['']"
                x-show="services"
                x-on:click="closeServicesOnLink($event)"
                x-cloak
                x-transition:enter="transition-opacity duration-150"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
              >
                <div class="hairline-gradient absolute inset-x-6 top-0" aria-hidden="true"></div>
                <!-- Opens with a short fade; closes instantly, so nothing of it lingers into a page transition. -->
                <!-- Balanced columns: intro | Managed + Practical AI | Cloud & DevOps (2 sub-columns) | Web & SaaS.
                       Height is capped at 70vh; the inner wrapper scrolls if a short laptop screen still needs it
                       (the outer panel keeps its hover bridge above). -->
                <div class="grid max-h-[70vh] grid-cols-[9rem_minmax(0,1fr)_minmax(0,2fr)_minmax(0,1fr)] gap-4 overflow-y-auto p-4 xl:grid-cols-[11rem_minmax(0,1fr)_minmax(0,2fr)_minmax(0,1fr)] xl:gap-5 xl:p-5">
                  <div class="border-r border-border pr-4">
                    <p class="eyebrow">Services</p>
                    <p class="mt-2 hidden text-base font-semibold text-fg xl:block">
                      Enterprise engineering, end to end
                    </p>
                    <a
                      href="/services"
                      class="mt-2 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-link hover:underline"
                    >
                      View all services
                      <ArrowRight aria-hidden="true" className="size-4" />
                    </a>
                    <a
                      href="/start-here"
                      class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-link hover:underline"
                    >
                      Start here
                      <ArrowRight aria-hidden="true" className="size-4" />
                    </a>
                  </div>

                  <div class="space-y-3">
                    <div data-menu-pillar="managed">
                      <p class={groupHeading}>{pillar.managed.title}</p>
                      <ul class="mt-1.5">
                        {pillar.managed.services.map((service) => (
                          <MenuServiceLink service={service} />
                        ))}
                      </ul>
                    </div>
                    <div data-menu-pillar="ai">
                      <p class={groupHeading}>{pillar.ai.title}</p>
                      <ul class="mt-1.5">
                        {pillar.ai.services.map((service) => (
                          <MenuServiceLink service={service} />
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div data-menu-pillar="cloud-devops">
                    <p class={groupHeading}>{pillar['cloud-devops'].title}</p>
                    <div class="mt-1.5 grid grid-cols-2 gap-x-2">
                      {cloudColumns.map((column) => (
                        <ul>
                          {column.map((service) => (
                            <MenuServiceLink service={service} />
                          ))}
                        </ul>
                      ))}
                    </div>
                  </div>

                  <div data-menu-pillar="web-saas">
                    <p class={groupHeading}>{pillar['web-saas'].title}</p>
                    <ul class="mt-1.5">
                      {pillar['web-saas'].services.map((service) => (
                        <MenuServiceLink service={service} />
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                data-nav-link="desktop"
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={linkClass(link.href)}
              >
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <div class="hidden lg:block">
        <Button href={cta.href} class="whitespace-nowrap">
          {cta.primary}
        </Button>
      </div>
      <button
        type="button"
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-fg hover:bg-surface-2 lg:hidden"
        aria-controls="mobile-nav"
        x-ref="menuButton"
        x-bind:aria-expanded="open.toString()"
        aria-expanded="false"
        x-on:click="open = !open"
      >
        <span class="sr-only" x-text="open ? 'Close menu' : 'Open menu'">
          Open menu
        </span>
        <span x-show="!open" class="inline-flex">
          <Menu aria-hidden="true" className="size-6" />
        </span>
        <span x-show="open" x-cloak class="inline-flex">
          <X aria-hidden="true" className="size-6" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer: a separate rounded card that unfolds just below the floating bar. -->
  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="pointer-events-auto mx-auto mt-2 max-h-[calc(100dvh-6.5rem)] max-w-7xl overflow-y-auto rounded-2xl border border-border/60 bg-surface shadow-lg shadow-black/5 lg:hidden dark:shadow-purple-950/20"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.150ms
    x-on:click.outside="open = false"
  >
    <ul class="flex flex-col px-3 py-3 sm:px-4">
      {navLinks.map((link) =>
        link.href === '/services' ? (
          <li>
            <!-- Expandable Services: the four pillars as collapsible groups (native details/summary, collapsed). -->
            <button
              type="button"
              class="flex min-h-12 w-full items-center justify-between rounded-lg px-2 text-left text-base font-medium text-fg hover:text-accent"
              aria-controls="mobile-services"
              aria-expanded="false"
              x-bind:aria-expanded="mobileServices.toString()"
              x-on:click="mobileServices = !mobileServices"
              data-mobile-services-toggle
            >
              {link.label}
              <span
                class="inline-flex text-muted transition-transform duration-200"
                x-bind:class="mobileServices && 'rotate-180'"
              >
                <ChevronDown aria-hidden="true" className="size-5" />
              </span>
            </button>
            <div
              id="mobile-services"
              class="pb-2 pl-2"
              x-show="mobileServices"
              x-cloak
              x-transition.opacity.duration.150ms
            >
              <a
                href="/services"
                data-nav-link="mobile"
                class="flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-semibold text-link"
              >
                View all services
                <ArrowRight aria-hidden="true" className="size-4" />
              </a>
              <a
                href="/start-here"
                data-nav-link="mobile"
                class="flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-semibold text-link"
              >
                Start here
                <ArrowRight aria-hidden="true" className="size-4" />
              </a>
              {groups.map((g) => (
                <details class="group" data-mobile-pillar={g.pillar}>
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-lg px-2 text-sm font-semibold text-fg hover:text-accent [&::-webkit-details-marker]:hidden">
                    {g.title}
                    <span class="inline-flex text-muted transition-transform duration-200 group-open:rotate-180">
                      <ChevronDown aria-hidden="true" className="size-4" />
                    </span>
                  </summary>
                  <ul class="pb-1 pl-2">
                    {g.services.map((service) => (
                      <li>
                        <a
                          href={serviceHref(service)}
                          data-nav-link="mobile"
                          class="flex min-h-11 items-center rounded-lg px-2 text-sm text-muted hover:text-accent"
                        >
                          {service.data.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          </li>
        ) : (
          <li>
            <a
              href={link.href}
              data-nav-link="mobile"
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="flex min-h-12 items-center rounded-lg px-2 text-base font-medium text-fg hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ),
      )}
      <li class="pt-3 pb-2">
        <Button href={cta.href} class="w-full">
          {cta.primary}
        </Button>
      </li>
    </ul>
  </nav>
</header>
