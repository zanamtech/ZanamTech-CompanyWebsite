---
import { ArrowRight, ChevronDown, Menu, X } from 'lucide-react';
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { navLinks, cta } from '../../data/site';
import { getActiveServices, serviceGroups, serviceHref, type ServiceGroup } from '../../lib/services';

// Header logo under evaluation. To compare, change the file name (files live in public/assets/):
//   '/assets/ZanamTechTestLogoL.png'   or   '/assets/ZanamTechTestLogo2L.png'
const headerLogo = '/assets/ZanamTechTestLogo4L.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const services = await getActiveServices();
const groups = (Object.keys(serviceGroups) as ServiceGroup[]).map((key) => ({
  key,
  title: serviceGroups[key].title,
  services: services.filter((s) => s.data.group === key),
}));
const linkClass = (href: string) => [
  'inline-flex min-h-11 items-center rounded-lg px-3.5 text-sm font-medium transition-colors duration-150 hover:text-accent',
  isActive(href) ? 'text-accent' : 'text-muted',
];
---

<header
  class="glass-bar sticky top-0 z-40"
  x-data="siteHeader"
  x-on:keydown.escape.window="onEscape()"
>
  <div class="container-page flex h-16 items-center justify-between gap-6 lg:h-18">
    <a href="/" class="inline-flex shrink-0 items-center rounded-md" aria-label="ZanamTech home">
      <!-- 2400x600 canvas rendered at 224x56; the file's transparent padding keeps the artwork at a similar size to before. -->
      <img src={headerLogo} alt="ZanamTech" width="224" height="56" class="h-14 w-auto" fetchpriority="high" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) =>
            link.href === '/services' ? (
              <li class="flex items-center" x-on:click.outside="services = false">
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[...linkClass(link.href), 'pr-1']}
                >
                  {link.label}
                </a>
                <button
                  type="button"
                  class="inline-flex size-11 items-center justify-center rounded-lg text-muted hover:text-accent"
                  aria-label="Show services menu"
                  aria-controls="services-menu"
                  aria-expanded="false"
                  x-ref="servicesButton"
                  x-bind:aria-expanded="services.toString()"
                  x-on:click="services = !services"
                >
                  <span class="inline-flex transition-transform duration-200" x-bind:class="services && 'rotate-180'">
                    <ChevronDown aria-hidden="true" className="size-4" />
                  </span>
                </button>

                <div
                  id="services-menu"
                  class="absolute inset-x-0 top-full border-y border-border bg-surface shadow-xl"
                  x-show="services"
                  x-cloak
                  x-transition.opacity.duration.150ms
                >
                  <div class="container-page grid gap-10 py-10 lg:grid-cols-12">
                    <div class="lg:col-span-3">
                      <p class="eyebrow">Services</p>
                      <p class="mt-3 text-lg font-semibold text-fg">Enterprise engineering, end to end</p>
                      <p class="mt-2 text-sm text-muted">
                        Nine core disciplines, each scoped to measurable targets in a Statement of Work.
                      </p>
                      <a
                        href="/services"
                        class="mt-5 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-link hover:underline"
                      >
                        View all services
                        <ArrowRight aria-hidden="true" className="size-4" />
                      </a>
                    </div>
                    {groups.map((group) => (
                      <div class="lg:col-span-4 xl:col-span-4">
                        <p class="text-sm font-semibold text-muted">{group.title}</p>
                        <ul class="mt-3 space-y-1">
                          {group.services.map((service) => (
                            <li>
                              <a
                                href={serviceHref(service)}
                                class="group/item flex min-h-11 items-center gap-3 rounded-xl px-2 py-2 hover:bg-surface-2"
                              >
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-cyan/12 text-brand-cyan">
                                  <Icon name={service.data.icon} class="size-4.5" />
                                </span>
                                <span class="text-sm font-medium text-fg group-hover/item:text-accent">
                                  {service.data.name}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={linkClass(link.href)}>
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <div class="hidden sm:block">
        <Button href={cta.href} contactCta>{cta.primary}</Button>
      </div>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg text-fg hover:bg-surface-2 lg:hidden"
        aria-controls="mobile-nav"
        x-ref="menuButton"
        x-bind:aria-expanded="open.toString()"
        aria-expanded="false"
        x-on:click="open = !open"
      >
        <span class="sr-only" x-text="open ? 'Close menu' : 'Open menu'">Open menu</span>
        <span x-show="!open" class="inline-flex"><Menu aria-hidden="true" className="size-6" /></span>
        <span x-show="open" x-cloak class="inline-flex"><X aria-hidden="true" className="size-6" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-border bg-surface lg:hidden"
    x-show="open"
    x-cloak
    x-transition.opacity.duration.150ms
    x-on:click.outside="open = false"
  >
    <ul class="container-page flex flex-col py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="flex min-h-12 items-center rounded-lg px-2 text-base font-medium text-fg hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3 pb-2">
        <Button href={cta.href} contactCta class="w-full">{cta.primary}</Button>
      </li>
    </ul>
  </nav>
</header>
