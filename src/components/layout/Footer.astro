---
import { ChevronDown } from '@lucide/astro';
import Logo from './Logo.astro';
import LinkedInIcon from '../ui/LinkedInIcon.astro';
import { site, footerCopy } from '../../data/site';
import { leadership } from '../../data/leadership';
import { serviceHref } from '../../lib/services';
import { getNavModel } from '../../lib/navigation';

// Same grouping and gating as the header (src/lib/navigation.ts): Managed + Practical AI together, Cloud & DevOps
// split into two sub-columns.
const { company, legal, pillars: groups, pillar, cloudColumns } = await getNavModel(Astro.url);

const year = new Date().getFullYear();
// Phones: 44px touch rows. Tablet/desktop service lists use an even gap between items instead (serviceList +
// serviceLink), so a link that wraps to two lines keeps the same spacing as its neighbors.
const linkClass = 'inline-flex min-h-11 items-center text-sm text-muted hover:text-accent lg:min-h-8';
const serviceList = 'mt-1.5 space-y-0.5';
const serviceLink = 'block py-1 text-sm text-muted hover:text-accent';
const headingClass = 'text-xs font-semibold tracking-wide text-fg uppercase';
// Company row (md+): one line from the first service column to the right edge. An equal-growth spacer sits between the
// label and each pair of links (so the items spread evenly, like justify-between); the label's small right margin makes
// its gap slightly wider than the gaps between links.
const spacerClass = 'relative hidden md:block md:w-6 md:shrink-0 md:grow md:basis-6 md:self-stretch';
---

<footer class="relative mt-9 border-t sm:mt-12 lg:mt-14 border-border bg-surface">
  <div class="hairline-gradient absolute inset-x-0 top-0" aria-hidden="true"></div>
  <!-- From xl: a narrow brand column (the description wraps to fill the height down to the email) and the services area,
       with a wider gap between them than between service columns.
       From md the bottom padding matches the Company row's top padding, so the row sits evenly between the divider and the bottom bar. -->
  <div class="container-page grid gap-8 pt-10 pb-10 md:pt-8 md:pb-3.25 lg:pt-9.5 xl:grid-cols-[17.5rem_minmax(0,1fr)] xl:gap-x-12">
    <!-- Brand block: a column from xl (email pinned to the bottom, level with the Company row), a single row at lg, stacked below. -->
    <div class="lg:flex lg:flex-wrap lg:items-center lg:gap-x-8 lg:gap-y-3 xl:flex-col xl:flex-nowrap xl:items-start xl:gap-0">
      <Logo height={24} />
      <p class="mt-4 max-w-sm text-sm text-muted md:hidden">{footerCopy.tagline}</p>
      <p class="mt-4 hidden max-w-md text-sm text-muted md:block lg:mt-0 lg:max-w-xl xl:mt-4 xl:max-w-none">
        {footerCopy.description}
      </p>
      <!-- Contact email with the company LinkedIn icon beside it (same line, level with the Company row at xl). -->
      <p class="mt-3 flex items-center gap-3 text-sm lg:mt-0 xl:mt-auto xl:pt-4">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex min-h-11 items-center font-semibold text-link hover:underline lg:min-h-8"
        >
          {site.email}
        </a>
        {leadership.companyLinkedin && (
          <a
            href={leadership.companyLinkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ZanamTech on LinkedIn"
            class="inline-flex size-11 items-center justify-center rounded-lg text-muted transition-colors duration-200 hover:text-accent lg:size-8"
            data-footer-linkedin
          >
            <LinkedInIcon class="size-4.5" />
          </a>
        )}
      </p>
    </div>

    <!-- Services and the Company row share one area that spans to the right edge. On phones the wrapper is `contents`,
         so its children stack in the footer grid as before; from md the Company row sits at the bottom, level with the
         email line in the brand column at xl.
         From lg the wrapper is one grid of four columns with equal 32px gaps; the service lists and the Company row use
         the same columns through subgrid. Column widths are tuned so the visible space between the columns' text is
         even: weighted below 1200px (where the first column's text fills its column), equal from 1200px. -->
    <div class="contents md:flex md:flex-col md:gap-4.75 lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1.05fr)_minmax(0,0.9fr)_minmax(0,0.95fr)] lg:grid-rows-[1fr_auto] lg:gap-x-8 min-[75rem]:grid-cols-[repeat(4,minmax(0,1fr))]">
      <nav
        aria-label="Services"
        class="hidden md:block lg:col-span-full lg:grid lg:grid-cols-subgrid"
        data-footer-services
      >
        <h2 class="sr-only">Services</h2>
        <div class="grid gap-x-8 gap-y-6 md:grid-cols-2 lg:col-span-full lg:grid-cols-subgrid">
          <div class="space-y-5">
            {[pillar.managed, pillar.ai].map((g) => (
              <div data-footer-pillar={g.pillar}>
                <h3 class={headingClass}>{g.title}</h3>
                <ul class={serviceList}>
                  {g.services.map((s) => (
                    <li>
                      <a href={serviceHref(s)} class={serviceLink}>
                        {s.data.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="lg:col-span-2 lg:grid lg:grid-cols-subgrid lg:content-start" data-footer-pillar="cloud-devops">
            <h3 class:list={[headingClass, 'lg:col-span-2']}>{pillar['cloud-devops'].title}</h3>
            <!-- Two independent lists (not shared rows) in the shared columns, so their gap matches the others. -->
            <div class="grid gap-x-8 lg:col-span-2 lg:grid-cols-subgrid">
              {cloudColumns.map((column) => (
                <ul class={serviceList}>
                  {column.map((s) => (
                    <li>
                      <a href={serviceHref(s)} class={serviceLink}>
                        {s.data.name}
                      </a>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
          <div data-footer-pillar="web-saas">
            <h3 class={headingClass}>{pillar['web-saas'].title}</h3>
            <ul class={serviceList}>
              {pillar['web-saas'].services.map((s) => (
                <li>
                  <a href={serviceHref(s)} class={serviceLink}>
                    {s.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>

      <!-- Services, phones: the four pillars as collapsible groups (native details/summary, collapsed). -->
      <nav aria-label="Services" class="md:hidden" data-footer-services-mobile>
        <h2 class="sr-only">Services</h2>
        {groups.map((g) => (
          <details class="group border-b border-border" data-footer-pillar-mobile={g.pillar}>
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-sm font-semibold text-fg hover:text-accent [&::-webkit-details-marker]:hidden">
              {g.title}
              <span class="inline-flex text-muted transition-transform duration-200 group-open:rotate-180">
                <ChevronDown aria-hidden="true" class="size-4" />
              </span>
            </summary>
            <ul class="pb-2">
              {g.services.map((s) => (
                <li>
                  <a href={serviceHref(s)} class={linkClass}>
                    {s.data.name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </nav>

      <!-- Company: a two-column list on phones; from md a single row spanning the services area. Between the label and
           each pair of links sits a spacer (24px minimum, equal growth), so the gaps between links are equal and the label's
           gap is 14px wider (its right margin); the spacers between links carry a dot centered in the gap. From md the list is `display: contents` (role="list"
           keeps its semantics), so the label, spacers and links share one flex row. -->
      <nav
        aria-label="Company"
        class="md:mt-auto md:flex md:items-baseline md:border-t md:border-border md:pt-3.25 lg:col-span-full"
        data-footer-company
      >
        <h2 class:list={[headingClass, 'md:mr-3.5']}>Company</h2>
        <span aria-hidden="true" class={spacerClass}></span>
        <ul role="list" class="mt-2 grid grid-cols-2 gap-x-6 md:contents">
          {company.map((link, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class={spacerClass} data-footer-dot>
                  <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-sm text-muted">·</span>
                </li>
              )}
              <li class="md:shrink-0">
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            </>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-1 py-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} ZanamTech · Cloud, DevOps &amp; AI engineering</p>
      <nav aria-label="Legal">
        <!-- 24px between links (was 16px), with the Company row's centered dot in each gap. -->
        <ul class="flex">
          {legal.map((link, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class="relative w-6 shrink-0 self-stretch" data-footer-legal-dot>
                  <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-sm text-muted">·</span>
                </li>
              )}
              <li>
                <a href={link.href} class="inline-flex min-h-11 items-center hover:text-accent sm:min-h-0">
                  {link.label}
                </a>
              </li>
            </>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
