---
import { X } from 'lucide-react';
import ContactForm from './ContactForm.astro';
import { cta } from '../data/site';
---

<dialog
  transition:persist="contact-dialog"
  id="contact-dialog"
  aria-labelledby="contact-dialog-title"
  class="contact-dialog m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto md:max-w-2xl lg:max-h-[96vh] lg:max-w-4xl xl:max-w-5xl rounded-3xl border border-border bg-surface p-0 text-fg shadow-2xl"
  x-data
>
  <div class="relative p-5 sm:p-6">
    <div class="hairline-gradient absolute inset-x-8 top-0" aria-hidden="true"></div>
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2 id="contact-dialog-title" class="mt-1.5 text-xl font-bold text-fg sm:text-2xl">{cta.primary}</h2>
        <p class="mt-1 text-xs text-muted sm:text-sm">
          Share a few details about your environment, and our team will reach out shortly.
        </p>
      </div>
      <button
        type="button"
        class="-mt-1 -mr-2 inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-surface-2 hover:text-fg"
        aria-label="Close dialog"
        x-on:click="$store.contact.close()"
      >
        <X aria-hidden="true" className="size-5" />
      </button>
    </div>

    <div class="mt-2 sm:mt-3">
      <ContactForm idPrefix="dialog" source="dialog">
        <div slot="success-actions" class="mt-8">
          <button
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border-strong px-6 font-semibold text-fg hover:border-accent hover:text-accent"
            x-on:click="$store.contact.close()"
          >
            Close
          </button>
        </div>
      </ContactForm>
    </div>
  </div>
</dialog>
