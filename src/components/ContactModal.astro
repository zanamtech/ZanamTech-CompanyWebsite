---
import { X } from 'lucide-react';
import ContactForm from './ContactForm.astro';
import { cta } from '../data/site';
---

<dialog
  id="contact-dialog"
  aria-labelledby="contact-dialog-title"
  class="contact-dialog m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded-3xl border border-border bg-surface p-0 text-fg shadow-2xl"
  x-data
>
  <div class="relative p-6 sm:p-8">
    <div class="hairline-gradient absolute inset-x-8 top-0" aria-hidden="true"></div>
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2
          id="contact-dialog-title"
          class="mt-2 text-2xl font-bold text-fg"
          x-text={`$store.contact.intent === 'proposal' ? '${cta.secondary}' : '${cta.primary}'`}
        >
          {cta.primary}
        </h2>
        <p class="mt-2 text-muted">
          Share a few details about your environment. A senior engineer will follow up to schedule a technical
          discussion.
        </p>
      </div>
      <button
        type="button"
        class="-mt-1 -mr-2 inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-surface-2 hover:text-fg"
        aria-label="Close dialog"
        x-on:click="$store.contact.close()"
      >
        <X aria-hidden="true" className="size-5" />
      </button>
    </div>

    <div class="mt-8">
      <ContactForm idPrefix="dialog" source="dialog">
        <div slot="success-actions" class="mt-8">
          <button
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border-strong px-6 font-semibold text-fg hover:border-accent hover:text-accent"
            x-on:click="$store.contact.close()"
          >
            Close
          </button>
        </div>
      </ContactForm>
    </div>
  </div>
</dialog>
