{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceContent",
  "type": "object",
  "required": ["order", "name", "group", "icon", "summary", "capabilities", "stack", "outcome", "scenarios", "status"],
  "properties": {
    "order": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 3 },
    "group": { "enum": ["cloud-infrastructure", "engineering-ai"] },
    "icon": { "type": "string" },
    "summary": { "type": "string", "maxLength": 220 },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 6 },
    "stack": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outcome": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["problem", "solution", "outcome"],
        "properties": {
          "problem": { "type": "string" },
          "solution": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["active", "roadmap"] }
  }
}
